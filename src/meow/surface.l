;;; surface.l — 도식 선택 + 슬롯 채움 (meowdlm 0.0016 계보 이관)
;;;
;;; meowdlm realize.py 의 결정 경로를 Maru 로 옮긴다. 해시는 sha256 대신 FNV-1a 64 를 쓴다
;;; (Maru 에 암호 해시가 없다). 구현은 FNV-1a 32비트(모듈러스 2^32)이다.
;;; 데이터: *frames* = (cat (token...) mean_q16), *slots* = (frame-index position (word...))
(define-function s-nth (xs n) (if (= n 0) (car xs) (s-nth (cdr xs) (- n 1))))
(define-function s-len-acc (xs a) (if (pair? xs) (s-len-acc (cdr xs) (+ a 1)) a))
(define-function s-len (xs) (s-len-acc xs 0))
(define-function s-rev-acc (xs acc) (if (pair? xs) (s-rev-acc (cdr xs) (cons (car xs) acc)) acc))
(define-function s-rev (xs) (s-rev-acc xs ()))
(define-function s-append-acc (xs ys) (if (pair? xs) (s-append-acc (cdr xs) (cons (car xs) ys)) ys))
(define-function s-append (xs ys) (s-append-acc (s-rev xs) ys))
(define-function s-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (s-member? x (cdr xs))) false))
(define-function %2 (n) (- n (* 2 (/ n 2))))
(define-function %10 (n) (- n (* 10 (/ n 10))))
(define-function s-xor-rest (x bit acc) (if (= 0 x) acc (s-xor-rest (/ x 2) (* bit 2) (if (= 0 (%2 x)) acc (+ acc bit)))))
(define-function s-xor-bits (a b bit acc) (if (= 0 a) (if (= 0 b) acc (s-xor-rest b bit acc)) (if (= 0 b) (s-xor-rest a bit acc) (s-xor-bits (/ a 2) (/ b 2) (* bit 2) (if (= (%2 a) (%2 b)) acc (+ acc bit))))))
(define-function s-xor (a b) (s-xor-bits a b 1 0))
(define-function s-mod32 (x) (let ((m 4294967296)) (if (>= x m) (- x (* m (/ x m))) x)))
(define-function s-fnv-acc (str i n h) (if (< i n) (s-fnv-acc str (+ i 1) n (s-mod32 (* (s-xor h (string-at str i)) 16777619))) h))
(define-function s-fnv (str) (s-fnv-acc str 0 (string-length str) 2166136261))
(define-function s-chars (s i n) (if (< i n) (cons (string-at s i) (s-chars s (+ i 1) n)) ()))
(define-function s-merge (as bs) (if (pair? as) (cons (car as) (s-merge (cdr as) bs)) bs))
(define-function s-int->str (n) (if (< n 10) (list->string (list (+ 48 n))) (list->string (s-merge (s-chars (s-int->str (/ n 10)) 0 (string-length (s-int->str (/ n 10)))) (list (+ 48 (%10 n)))))))
(define-function s-sep (a b) (list->string (s-merge (s-chars a 0 (string-length a)) (cons 124 (s-chars b 0 (string-length b))))))
(define-function s-frames-of-acc (cat frames acc i) (if (pair? frames) (if (equal (s-nth (car frames) 0) cat) (s-frames-of-acc cat (cdr frames) (cons (list i (car frames)) acc) (+ i 1)) (s-frames-of-acc cat (cdr frames) acc (+ i 1))) (s-rev acc)))
(define-function s-frames-of (cat frames) (s-frames-of-acc cat frames () 0))
(define-function s-near-key (entry target) (let* ((fr (s-nth entry 1)) (mean (s-nth fr 2)) (d (- mean target))) (if (< d 0) (- 0 d) d)))
(define-function s-near-of (e target) (s-near-key e target))
(define-function s-insert-key (x key sorted target) (if (pair? sorted) (if (< key (s-near-of (car sorted) target)) (cons x sorted) (cons (car sorted) (s-insert-key x key (cdr sorted) target))) (list x)))
(define-function s-sort-near (xs target sorted) (if (pair? xs) (s-sort-near (cdr xs) target (s-insert-key (car xs) (s-near-key (car xs) target) sorted target)) sorted))
(define-function s-words-at (slots fi pos) (if (pair? slots) (let ((s (car slots))) (if (and (= (s-nth s 0) fi) (= (s-nth s 1) pos)) (s-nth s 2) (s-words-at (cdr slots) fi pos))) ()))
(define-function s-render (tokens fi slots i seed attempt acc) (if (pair? tokens) (if (equal (car tokens) "*") (let ((cands (s-words-at slots fi i))) (if (not (pair? cands)) () (let* ((h (s-fnv (s-sep seed (s-sep (s-int->str i) (s-int->str attempt))))) (k (- h (* (s-len cands) (/ h (s-len cands))))) (w (s-nth cands k))) (s-render (cdr tokens) fi slots (+ i 1) seed attempt (cons w acc))))) (s-render (cdr tokens) fi slots (+ i 1) seed attempt (cons (car tokens) acc))) (s-rev acc)))
(define-function s-pick-frame (pool seed cat attempt) (let* ((h (s-fnv (s-sep seed (s-sep cat (s-int->str attempt))))) (k (- h (* (s-len pool) (/ h (s-len pool)))))) (s-nth pool k)))
(define-function s-cap (cs) (if (pair? cs) (cons (if (and (<= 97 (car cs)) (<= (car cs) 122)) (- (car cs) 32) (car cs)) (cdr cs)) cs))
(define-function s-cat-chars (out) (if (pair? out) (if (pair? (cdr out)) (s-merge (s-chars (car out) 0 (string-length (car out))) (cons 32 (s-cat-chars (cdr out)))) (s-chars (car out) 0 (string-length (car out)))) ()))
(define-function s-finish (out) (list->string (s-merge (s-cap (s-cat-chars out)) (list 46))))
(define-function s-try (pool seed cat slots attempt tries) (if (>= attempt tries) () (let* ((entry (s-pick-frame pool seed cat attempt)) (fi (s-nth entry 0)) (fr (s-nth entry 1)) (toks (s-nth fr 1)) (out (s-render toks fi slots 0 seed attempt ()))) (if (pair? out) (s-finish out) (s-try pool seed cat slots (+ attempt 1) tries)))))
(define-function s-realize (cat seed target frames slots tries) (let ((pool (s-sort-near (s-frames-of cat frames) target ()))) (if (not (pair? pool)) () (s-try pool seed cat slots 0 tries))))