(define-function lx-nth (xs n) (if (= n 0) (car xs) (lx-nth (cdr xs) (- n 1))))
(define-function lx-len-acc (xs a) (if (pair? xs) (lx-len-acc (cdr xs) (+ a 1)) a))
(define-function lx-len (xs) (lx-len-acc xs 0))
(define-function lx-rev (xs acc) (if (pair? xs) (lx-rev (cdr xs) (cons (car xs) acc)) acc))
(define-function lx-append (a b) (if (pair? a) (cons (car a) (lx-append (cdr a) b)) b))
(define-function lx-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (lx-member? x (cdr xs))) false))
(define-function lx-assoc (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (lx-assoc k (cdr xs))) ()))
(define-function lx-cats (w lex) (let ((e (lx-assoc w lex))) (if (pair? e) (car (cdr e)) ())))
(define-function lx-set (lex w cats) (if (pair? lex) (if (equal w (car (car lex))) (cons (list w cats) (cdr lex)) (cons (car lex) (lx-set (cdr lex) w cats))) ()))
(define-function lx-multi (lex acc) (if (pair? lex) (lx-multi (cdr lex) (if (> (lx-len (car (cdr (car lex)))) 1) (cons (car (car lex)) acc) acc)) (lx-rev acc ())))
(define-function lx-total (lex acc) (if (pair? lex) (lx-total (cdr lex) (+ acc (lx-len (car (cdr (car lex)))))) acc))
(define-function lx-sents-with (w sents acc) (if (pair? sents) (lx-sents-with w (cdr sents) (if (lx-member? w (car sents)) (cons (car sents) acc) acc)) (lx-rev acc ())))
(define-function lx-all-derive? (sents rules lex) (if (not (pair? sents)) true (if (syn-accepts (car sents) rules lex) (lx-all-derive? (cdr sents) rules lex) false)))
(define-function lx-remove (x xs) (if (pair? xs) (if (equal x (car xs)) (lx-remove x (cdr xs)) (cons (car xs) (lx-remove x (cdr xs)))) ()))
(define-function lx-try (lex w cat rules sents floor) (if (<= (lx-len (lx-cats w lex)) floor) (list lex false) (let ((nl (lx-set lex w (lx-remove cat (lx-cats w lex))))) (if (lx-all-derive? (lx-sents-with w sents ()) rules nl) (list nl true) (list lex false)))))
(define-function lx-pass (lex words rules sents floor removed blocked) (if (not (pair? words)) (list lex removed blocked) (let* ((w (car words)) (cat (car (lx-cats w lex))) (r (lx-try lex w cat rules sents floor))) (if (car (cdr r)) (lx-pass (car r) (cdr words) rules sents floor (+ removed 1) blocked) (lx-pass lex (cdr words) rules sents floor removed (+ blocked 1))))))
(define-function lx-prune (lex rules sents rounds floor) (if (= rounds 0) lex (let ((r (lx-pass lex (lx-multi lex ()) rules sents floor 0 0))) (if (= (car (cdr r)) 0) lex (lx-prune (car r) rules sents (- rounds 1) floor)))))
