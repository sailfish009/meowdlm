            (if (equal y 'none) false (if (fg-univ x y) (fg-ifv-eq1 (cdr a) b) false))))))))
(define-function fg-ifv-eq (a b) (if (= (fg-len a) (fg-len b)) (if (fg-ifv-eq1 a b) (fg-ifv-eq1 b a) false) false))
;; 대조기 on/off (게이트의 판별 ablation 용)
(define *fg-ifv-check* 1)
(define-function fg-ifv-check (a b) (if (= *fg-ifv-check* 0) true (fg-ifv-eq a b)))
(define-function fg-kids-shape (kids spec)
  (if (not (pair? kids)) (not (pair? spec))
    (if (not (pair? spec)) false
