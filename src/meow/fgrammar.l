          (fg-chk-seeds cons_ t s decl (cdr rs)))
        (fg-chk-seeds cons_ t s decl (cdr rs))))))
(define-function fg-chk-child (kid t s decl)
  (fg-chk-seeds (cdr kid) t s decl (fg-rules (car kid) decl)))
(define-function fg-chk (t decl params)
  (if (not (pair? t)) false
