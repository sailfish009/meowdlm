            (fg-gwords (cdr ws) kid s acc)))
        (fg-gwords (cdr ws) kid s acc)))))
(define-function fg-gleaf (kid s) (fg-gwords *lf-lex* kid s ()))
(define-function fg-gkid (lk kid s)
  (if (fg-term-lk? lk kid) (fg-gleaf kid s) (fg-gcat lk (car kid) (cdr kid) s)))
(define-function fg-gkids (lk kids s)
  (if (not (pair? kids)) (list (list s () () ()))
    (fg-gchain lk (fg-gkid lk (car kids) s) (cdr kids))))
(define-function fg-gchain (lk items kids)
  (if (not (pair? items)) ()
    (let* ((a (car items)) (rest (fg-limit (fg-gkids lk kids (car a)) 12)))
      (fg-append (fg-gpair a rest) (fg-gchain lk (cdr items) kids)))))
(define-function fg-done (alts) (if (not (pair? alts)) () (if (pair? (cdr (car alts))) (fg-done (cdr alts)) (list true))))
(define-function fg-accept-alts (toks decl) (fg-done (fg-mcat (fg-lk-decl decl) 'S () (fg-nilsub) toks)))
(define-function fg-accept-gen (toks decl) (if (pair? (fg-accept-alts toks decl)) true false))
(define-function fg-accept-idx (toks idx) (if (pair? (fg-done (fg-mcat (fg-lk-idx idx) 'S () (fg-nilsub) toks))) true false))
(define-function fg-nows (items) (if (not (pair? items)) () (if (pair? (car (cdr (car items)))) (cons (car (cdr (car items))) (fg-nows (cdr items))) (fg-nows (cdr items)))))
(define-function fg-ntrees (items) (if (not (pair? items)) () (cons (fg-g3 (car items)) (fg-ntrees (cdr items)))))
(define-function fg-gen-list (n decl) (fg-limit (fg-nows (fg-gcat (fg-lk-decl decl) 'S () (fg-nilsub))) n))
(define-function fg-tree-list (n decl) (fg-limit (fg-ntrees (fg-gcat (fg-lk-decl decl) 'S () (fg-nilsub))) n))
(define-function fg-tree-cat (t) (car (cdr t)))
(define-function fg-node? (t) (if (pair? t) (equal (car t) 'node) false))
(define-function fg-ifv-of (t) (if (fg-leaf? t) () (car (cdr (cdr t)))))
(define-function fg-params-of (t) (if (fg-leaf? t) () (car (cdr (cdr (cdr (cdr t)))))))
(define-function fg-kids-of (t) (if (fg-leaf? t) () (car (cdr (cdr (cdr (cdr (cdr t))))))))
(define-function fg-ifv-eq1 (a b)
