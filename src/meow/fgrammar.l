(define-function fg-nilsub () (list (cons 'zz 0)))
(define-function fg-nth (xs n) (if (= n 0) (car xs) (fg-nth (cdr xs) (- n 1))))
(define-function fg-len-acc (xs a) (if (pair? xs) (fg-len-acc (cdr xs) (+ a 1)) a))
(define-function fg-len (xs) (fg-len-acc xs 0))
(define-function fg-append (a b) (if (pair? a) (cons (car a) (fg-append (cdr a) b)) b))
(define-function fg-limit (xs n) (if (or (= n 0) (not (pair? xs))) () (cons (car xs) (fg-limit (cdr xs) (- n 1)))))
(define-function fg-mem? (x xs) (if (pair? xs) (if (equal x (car xs)) true (fg-mem? x (cdr xs))) false))
(define-function fg-assq (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (fg-assq k (cdr xs))) ()))
(define-function fg-idx (f) (if (equal f 'p) 2 (if (equal f 'n) 3 (if (equal f 'c) 4 5))))
(define-function fg-look (k s) (if (pair? s) (if (equal k (car (car s))) (list (cdr (car s))) (fg-look k (cdr s))) ()))
(define-function fg-set (k v s) (cons (cons k v) s))
(define-function fg-univ (a b) (if (= a -1) true (if (= b -1) true (= a b))))
(define-function fg-norm (x) (if (equal x 'unbound) -1 x))
(define-function fg-agree3 (vp vn sp sn strict)
  (let* ((p2 (if (= sp -1) 3 sp)))
    (if (and (not (= vp -1)) (not (= vp p2))) false
      (if (and strict (not (= vn -1)) (not (= vn sn))) false
        (if (and (not strict) (not (= vn -1)) (not (= sn -1)) (not (= vn sn))) false
          (if (and (= vp -1) (= sn 0) (= p2 3)) false true))))))
(define-function fg-agree2 (vp vn sp sn) (fg-agree3 vp vn sp sn true))
(define-function fg-agree (vp vn sp sn) (fg-agree2 (fg-norm vp) (fg-norm vn) (fg-norm sp) (fg-norm sn)))
(define-function fg-agree-cop (vp vn sp sn) (fg-agree3 (fg-norm vp) (fg-norm vn) (fg-norm sp) (fg-norm sn) false))
(define-function fg-det-n2 (a b) (if (= a -1) true (if (= b -1) true (= a b))))
(define-function fg-det-n (a b) (fg-det-n2 (fg-norm a) (fg-norm b)))
(define-function fg-apply-guard (nm vs)
  (if (equal nm 'intr) (equal (car vs) "intr")
    (if (equal nm 'tr) (equal (car vs) "tr")
      (if (equal nm 'agree) (fg-agree (car vs) (car (cdr vs)) (car (cdr (cdr vs))) (car (cdr (cdr (cdr vs)))))
        (if (equal nm 'agree-cop) (fg-agree-cop (car vs) (car (cdr vs)) (car (cdr (cdr vs))) (car (cdr (cdr (cdr vs)))))
          (if (equal nm 'det-n) (fg-det-n (car vs) (car (cdr vs))) false))))))
(define-function fg-val1 (v s) (if (symbol? v) (let ((r (fg-look v s))) (if (pair? r) (car r) 'unbound)) v))
(define-function fg-vals (vs s acc) (if (not (pair? vs)) acc (fg-vals (cdr vs) s (cons (fg-val1 (car vs) s) acc))))
(define-function fg-rev (xs acc) (if (pair? xs) (fg-rev (cdr xs) (cons (car xs) acc)) acc))
(define-function fg-guard-ok (c s) (fg-apply-guard (car (cdr c)) (fg-rev (fg-vals (cdr (cdr c)) s ()) ())))
(define-function fg-c1-bind (c s)
  (let* ((v (car (cdr c))) (val (car (cdr (cdr c)))) (cur (fg-look v s)))
    (if (pair? cur) (list (fg-univ (car cur) val) s) (list true (fg-set v val s)))))
(define-function fg-c1-feat (c e s)
  (let* ((f (car c)) (want (car (cdr c))) (got (fg-nth e (fg-idx f))))
    (if (symbol? want)
      (let ((cur (fg-look want s)))
        (if (pair? cur) (list (fg-univ got (car cur)) s)
          (if (= got -1) (list true s) (list true (fg-set want got s)))))
      (list (fg-univ got want) s))))
(define-function fg-c1 (c e s)
  (if (equal (car c) 'bind) (fg-c1-bind c s)
    (if (equal (car c) 'guard) (list (fg-guard-ok c s) s)
      (fg-c1-feat c e s))))
(define-function fg-cons (cs e s)
  (if (not (pair? cs)) (list true s)
    (let ((r (fg-c1 (car cs) e s)))
      (if (car r) (fg-cons (cdr cs) e (car (cdr r))) (list false s)))))
(define-function fg-rules (cat decl)
  (if (pair? decl) (if (equal cat (car (car decl))) (cons (cdr (car decl)) (fg-rules cat (cdr decl))) (fg-rules cat (cdr decl))) ()))
(define-function fg-has-iface? (r) (if (pair? r) (equal (car r) '=>) false))
(define-function fg-has-sem? (x) (if (pair? x) (equal (car x) 'sem) false))
(define-function fg-iface (r) (if (fg-has-iface? r) (car (cdr r)) ()))
(define-function fg-sem-spec (r)
  (if (not (fg-has-iface? r)) 'none
    (if (not (pair? (cdr (cdr r)))) 'none
      (if (fg-has-sem? (car (cdr (cdr r)))) (car (cdr (cdr r))) 'none))))
(define-function fg-kids (r)
  (if (not (fg-has-iface? r)) r
    (let ((k (cdr (cdr r)))) (if (and (pair? k) (fg-has-sem? (car k))) (cdr k) k))))
(define-function fg-if1 (ic cs)
  (let* ((d (if (pair? (cdr (cdr ic))) (car (cdr (cdr ic))) 'none))
         (v (car (cdr ic))) (cur (fg-look v cs)))
    (if (pair? cur)
      (if (equal d 'none) (list true cs) (list (fg-univ (car cur) d) cs))
      (if (equal d 'none) (list true cs) (list true (fg-set v d cs))))))
(define-function fg-ifall (ics cs)
  (if (not (pair? ics)) (list true cs)
    (let ((r (fg-if1 (car ics) cs)))
      (if (car r) (fg-ifall (cdr ics) (car (cdr r))) (list false cs)))))
(define-function fg-ifvals (ics cs)
  (if (not (pair? ics)) ()
    (let* ((r (fg-if1 (car ics) cs)) (cs2 (car (cdr r))) (v (car (cdr (car ics)))) (cur (fg-look v cs2)))
      (cons (cons (car (car ics)) (if (pair? cur) (car cur) 'none)) (fg-ifvals (cdr ics) cs2)))))
(define-function fg-merge-sub (a b) (if (not (pair? a)) b (fg-merge-sub (cdr a) (if (pair? (fg-look (car (car a)) b)) b (fg-set (car (car a)) (cdr (car a)) b)))))
(define-function fg-seed1 (c ics s child)
  (if (equal (car c) 'bind)
    (let ((r (fg-c1-bind c s))) (if (car r) (list true (fg-merge-sub (car (cdr r)) child)) (list false child)))
    (if (equal (car c) 'guard) (list (fg-guard-ok c s) child)
      (let ((ie (fg-assq (car c) ics)))
        (if (not (pair? ie)) (list true child)
          (let* ((v (car (cdr ie))) (w (car (cdr c)))
                 (val (if (symbol? w) (let ((r (fg-look w s))) (if (pair? r) (car r) 'none)) w)))
            (if (equal val 'none) (list true child)
              (let ((cur (fg-look v child)))
                (if (pair? cur) (list (fg-univ (car cur) val) child) (list true (fg-set v val child)))))))))))
(define-function fg-seed (cons_ ics s child)
  (if (not (pair? cons_)) (list true child)
    (let ((r (fg-seed1 (car cons_) ics s child)))
      (if (car r) (fg-seed (cdr cons_) ics s (car (cdr r))) (list false child)))))
(define-function fg-cmatch1 (c ifv s)
  (if (equal (car c) 'bind) (fg-c1-bind c s)
    (if (equal (car c) 'guard) (list (fg-guard-ok c s) s)
      (let ((e (fg-assq (car c) ifv)))
        (if (not (pair? e)) (list false s)
          (let ((val (cdr e)) (w (car (cdr c))))
            (if (equal val 'none) (list true s)
              (if (symbol? w)
                (let ((cur (fg-look w s)))
                  (if (pair? cur) (list (fg-univ (car cur) val) s) (list true (fg-set w val s))))
                (list (fg-univ val w) s)))))))))
(define-function fg-cmatch (cons_ ifv s)
  (if (not (pair? cons_)) (list true s)
    (let ((r (fg-cmatch1 (car cons_) ifv s)))
      (if (car r) (fg-cmatch (cdr cons_) ifv (car (cdr r))) (list false s)))))
(define-function fg-lk-decl (decl) (lambda (c) (fg-rules c decl)))
(define-function fg-rules-i (cat idx) (let ((e (fg-assq cat idx))) (if (pair? e) (cdr e) ())))
(define-function fg-lk-idx (idx) (lambda (c) (fg-rules-i c idx)))
(define-function fg-term-lk? (lk kid) (not (pair? (lk (car kid)))))
(define-function fg-catlist (decl acc)
  (if (not (pair? decl)) acc
    (fg-catlist (cdr decl) (if (fg-mem? (car (car decl)) acc) acc (cons (car (car decl)) acc)))))
(define-function fg-idxp (cats decl)
  (if (not (pair? cats)) () (cons (cons (car cats) (fg-rules (car cats) decl)) (fg-idxp (cdr cats) decl))))
(define-function fg-index (decl) (fg-idxp (fg-catlist decl ()) decl))
(define-function fg-mcollect (alts ics cons_ s)
  (if (not (pair? alts)) ()
    (let* ((a (car alts)) (ok (fg-ifall ics (car a))))
      (if (not (car ok)) (fg-mcollect (cdr alts) ics cons_ s)
        (let* ((ifv (fg-ifvals ics (car (cdr ok)))) (r (fg-cmatch cons_ ifv s)))
          (if (car r) (cons (cons (car (cdr r)) (cdr a)) (fg-mcollect (cdr alts) ics cons_ s))
            (fg-mcollect (cdr alts) ics cons_ s)))))))
(define-function fg-leaf (kid s toks)
  (if (not (pair? toks)) ()
    (let ((e (lf-entry (car toks))))
      (if (not (pair? e)) ()
        (if (equal (lf-cat e) (symbol->string (car kid)))
          (let ((r (fg-cons (cdr kid) e s)))
            (if (car r) (list (cons (car (cdr r)) (cdr toks))) ()))
          ())))))
(define-function fg-mrule (lk r cons_ s toks)
  (let ((seed (fg-seed cons_ (fg-iface r) s (fg-nilsub))))
    (if (car seed)
      (fg-mcollect (fg-mkids lk (fg-kids r) (car (cdr seed)) toks) (fg-iface r) cons_ s)
      ())))
(define-function fg-mrules (lk rs cons_ s toks)
  (if (not (pair? rs)) ()
    (fg-append (fg-mrule lk (car rs) cons_ s toks) (fg-mrules lk (cdr rs) cons_ s toks))))
(define-function fg-mcat (lk cat cons_ s toks) (fg-mrules lk (lk cat) cons_ s toks))
(define-function fg-mkid (lk kid s toks)
  (if (fg-term-lk? lk kid) (fg-leaf kid s toks) (fg-mcat lk (car kid) (cdr kid) s toks)))
(define-function fg-mkids (lk kids s toks)
  (if (not (pair? kids)) (list (cons s toks))
    (fg-mchain lk (fg-mkid lk (car kids) s toks) (cdr kids))))
(define-function fg-mchain (lk alts kids)
  (if (not (pair? alts)) ()
    (let ((a (car alts)))
      (fg-append (fg-mkids lk kids (car a) (cdr a)) (fg-mchain lk (cdr alts) kids)))))
(define-function fg-g4 (i) (car (cdr (cdr (cdr i)))))
(define-function fg-leaf-word (t) (car (cdr (cdr t))))
(define-function fg-leaf? (t) (if (pair? t) (equal (car t) 'leaf) false))
(define-function fg-sem-of (t) (if (fg-leaf? t) (fg-leaf-word t) (car (cdr (cdr (cdr t))))))
(define-function fg-sem1 (t) (if (fg-leaf? t) (fg-leaf-word t) (fg-sem-of t)))
(define-function fg-sem-args (idxs kids)
  (if (not (pair? idxs)) () (cons (fg-sem1 (fg-nth kids (car idxs))) (fg-sem-args (cdr idxs) kids))))
(define-function fg-mk-sem (spec kids)
  (if (not (pair? spec)) () (cons (car (cdr spec)) (fg-sem-args (cdr (cdr spec)) kids))))
(define-function fg-gcollect (items ics sem params cons_ s cat)
  (if (not (pair? items)) ()
    (let* ((b (car items)) (ok (fg-ifall ics (car b))))
      (if (not (car ok)) (fg-gcollect (cdr items) ics sem params cons_ s cat)
        (let* ((ifv (fg-ifvals ics (car (cdr ok)))) (r (fg-cmatch cons_ ifv s)))
          (if (car r)
            (cons (list (car (cdr r)) (car (cdr b)) (list 'node cat ifv (fg-mk-sem sem (fg-g4 b)) params (fg-g4 b)) ())
                  (fg-gcollect (cdr items) ics sem params cons_ s cat))
            (fg-gcollect (cdr items) ics sem params cons_ s cat)))))))
(define-function fg-g3 (i) (car (cdr (cdr i))))
(define-function fg-gpair (a rest)
  (if (not (pair? rest)) ()
    (let ((b (car rest)))
      (cons (list (car b) (fg-append (car (cdr a)) (car (cdr b))) () (cons (fg-g3 a) (fg-g4 b)))
            (fg-gpair a (cdr rest))))))
(define-function fg-grule (lk cat r cons_ s)
  (let ((seed (fg-seed cons_ (fg-iface r) s (fg-nilsub))))
    (if (car seed)
      (let ((ps (car (cdr seed))))
        (fg-gcollect (fg-gkids lk (fg-kids r) ps) (fg-iface r) (fg-sem-spec r) ps cons_ s cat))
      ())))
(define-function fg-perrules (lk cat rs cons_ s)
  (if (not (pair? rs)) () (cons (fg-grule lk cat (car rs) cons_ s) (fg-perrules lk cat (cdr rs) cons_ s))))
(define-function fg-allnil? (ls) (if (not (pair? ls)) true (if (pair? (car ls)) false (fg-allnil? (cdr ls)))))
(define-function fg-heads (ls acc) (if (not (pair? ls)) acc (fg-heads (cdr ls) (if (pair? (car ls)) (cons (car (car ls)) acc) acc))))
(define-function fg-next (ls) (if (not (pair? ls)) () (cons (if (pair? (car ls)) (cdr (car ls)) ()) (fg-next (cdr ls)))))
(define-function fg-rr (lists acc)
  (if (fg-allnil? lists) acc (fg-rr (fg-next lists) (fg-heads lists acc))))
(define-function fg-grules (lk cat rs cons_ s) (fg-rr (fg-perrules lk cat rs cons_ s) ()))
(define-function fg-gcat (lk cat cons_ s) (fg-grules lk cat (lk cat) cons_ s))
(define-function fg-gwords (ws kid s acc)
  (if (not (pair? ws)) acc
    (let ((e (car ws)))
      (if (equal (lf-cat e) (symbol->string (car kid)))
        (let ((r (fg-cons (cdr kid) e s)))
          (if (car r)
