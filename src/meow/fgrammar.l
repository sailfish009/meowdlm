        (if (car r) (fg-path (cdr kids) (cdr ts) (car (cdr r)) true) (list false s))))))
(define-function fg-chk-leaf (t)
  (let ((e (lf-entry (fg-leaf-word t))))
    (if (pair? e) (equal (lf-cat e) (symbol->string (fg-tree-cat t))) false)))
(define-function fg-chk-kids (specs kids s decl)
  (if (not (pair? specs)) true
    (if (not (pair? kids)) false
      (if (fg-leaf? (car kids))
        (let ((after (fg-path1 (car specs) (car kids) s)))
          (if (car after)
            (if (fg-chk-leaf (car kids)) (fg-chk-kids (cdr specs) (cdr kids) (car (cdr after)) decl) false)
