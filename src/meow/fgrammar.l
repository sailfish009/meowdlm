(define-function fg-chk-rules (kids ifv sem params rs decl)
  (if (not (pair? rs)) false
    (if (fg-kids-shape kids (fg-kids (car rs)))
      (if (fg-chk-recon kids ifv sem params (car rs) decl) true
        (fg-chk-rules kids ifv sem params (cdr rs) decl))
      (fg-chk-rules kids ifv sem params (cdr rs) decl))))
(define-function fg-chk-recon (kids ifv sem params r decl)
  (let ((path (fg-path (fg-kids r) kids params true)))
    (if (not (car path)) false
      (let ((chk (fg-ifall (fg-iface r) (car (cdr path)))))
        (if (not (car chk)) false
          (if (not (equal sem (fg-mk-sem (fg-sem-spec r) kids))) false
            (if (not (fg-ifv-check ifv (fg-ifvals (fg-iface r) (car (cdr chk))))) false
              (fg-chk-kids (fg-kids r) kids params decl))))))))
(define-function fg-chk-tree (t decl)
  (if (not (fg-node? t)) false
    (if (not (equal (fg-tree-cat t) 'S)) false
      (if (not (equal (fg-params-of t) (fg-nilsub))) false
        (fg-chk t decl (fg-nilsub))))))