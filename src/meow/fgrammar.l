        (let ((after (fg-cmatch (cdr (car specs)) (fg-ifv-of (car kids)) s)))
          (if (car after)
            (if (fg-chk-child (car specs) (car kids) s decl)
              (fg-chk-kids (cdr specs) (cdr kids) (car (cdr after)) decl) false)
            false))))))
(define-function fg-chk-seeds (cons_ t s decl rs)
  (if (not (pair? rs)) false
    (let ((seed (fg-seed cons_ (fg-iface (car rs)) s (fg-nilsub))))
      (if (car seed)
        (if (equal (car (cdr seed)) (fg-params-of t))
