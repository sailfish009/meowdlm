(define-function lf-nth (xs n) (if (= n 0) (car xs) (lf-nth (cdr xs) (- n 1))))
(define-function lf-len-acc (xs a) (if (pair? xs) (lf-len-acc (cdr xs) (+ a 1)) a))
(define-function lf-len (xs) (lf-len-acc xs 0))
(define-function lf-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (lf-member? x (cdr xs))) false))
(define-function lf-assoc (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (lf-assoc k (cdr xs))) ()))
(define-function lf-cat (e) (lf-nth e 1))
(define-function lf-person (e) (lf-nth e 2))
(define-function lf-num (e) (lf-nth e 3))
(define-function lf-casev (e) (lf-nth e 4))
(define-function lf-val (e) (lf-nth e 5))
(define-function lf-unify (x y) (if (or (= x -1) (= y -1) (= x y)) true false))
(define-function lf-entry (w) (lf-assoc w *lf-lex*))
(define-function lf-cats (w) (let ((e (lf-entry w))) (if (pair? e) (list (lf-cat e)) ())))
(define-function lf-obj (toks i) (if (>= i (lf-len toks)) (list false (list "no-object")) (let ((o (lf-entry (lf-nth toks i)))) (if (not (pair? o)) (list false (list "unknown-word" (lf-nth toks i))) (if (equal (lf-cat o) "PRON") (if (or (= (lf-casev o) -1) (= (lf-casev o) 1)) (list true (+ i 1)) (list false (list "object-case" (lf-nth toks i)))) (if (equal (lf-cat o) "DET") (if (>= (+ i 1) (lf-len toks)) (list false (list "no-obj-noun")) (let ((nn (lf-entry (lf-nth toks (+ i 1))))) (if (not (pair? nn)) (list false (list "unknown-word" (lf-nth toks (+ i 1)))) (if (and (equal (lf-cat nn) "N") (lf-unify (lf-num o) (lf-num nn))) (list true (+ i 2)) (list false (list "obj-det-n-agree" (lf-nth toks (+ i 1)))))))) (list false (list "obj-cat" (lf-nth toks i)))))))))
(define-function lf-cop-comp (toks i) (if (>= i (lf-len toks)) (list false (list "no-complement")) (let ((c (lf-entry (lf-nth toks i)))) (if (not (pair? c)) (list false (list "unknown-word" (lf-nth toks i))) (if (equal (lf-cat c) "A") (if (= (+ i 1) (lf-len toks)) (list true ()) (list false (list "trailing" (lf-nth toks (+ i 1))))) (if (or (equal (lf-cat c) "DET") (equal (lf-cat c) "PRON")) (let ((r (lf-obj toks i))) (if (car r) (if (= (lf-nth r 1) (lf-len toks)) (list true ()) (list false (list "trailing" (lf-nth toks (lf-nth r 1))))) r)) (if (equal (lf-cat c) "PREP") (list true ()) (list false (list "comp-cat" (lf-nth toks i))))))))))
(define-function lf-cop (vw person num toks i) (let ((v (lf-entry vw))) (if (not (and (lf-unify (lf-num v) num) (lf-unify (lf-person v) person))) (list false (list "cop-agr" vw)) (lf-cop-comp toks i))))
(define-function lf-form-bad? (v person num) (if (and (not (= (lf-num v) -1)) (not (= (lf-num v) num))) true (if (and (not (= (lf-person v) -1)) (not (= (lf-person v) person))) true (if (and (= (lf-person v) -1) (= num 0) (= person 3)) true false))))
(define-function lf-verb (vw person num toks i) (let ((v (lf-entry vw))) (if (not (equal (lf-cat v) "V")) (list false (list "no-verb" vw)) (if (lf-form-bad? v person num) (list false (list "subj-verb-agr" vw)) (if (equal (lf-val v) "tr") (let ((r (lf-obj toks i))) (if (car r) (if (= (lf-nth r 1) (lf-len toks)) (list true ()) (list false (list "trailing" (lf-nth toks (lf-nth r 1))))) r)) (if (= i (lf-len toks)) (list true ()) (list false (list "trailing" (lf-nth toks i)))))))))
(define-function lf-check-verb (vw person num toks i) (let ((v (lf-entry vw))) (if (not (pair? v)) (list false (list "unknown-word" vw)) (if (equal (lf-cat v) "COP") (lf-cop vw person num toks i) (lf-verb vw person num toks i)))))
(define-function lf-check-pron-subj (toks subj) (if (not (or (= (lf-casev subj) -1) (= (lf-casev subj) 0))) (list false (list "case" (lf-nth toks 0))) (if (< (lf-len toks) 2) (list false (list "no-verb")) (lf-check-verb (lf-nth toks 1) (lf-person subj) (lf-num subj) toks 2))))
(define-function lf-check-np-subj (toks) (if (< (lf-len toks) 3) (list false (list "short")) (let ((d (lf-entry (lf-nth toks 0)))) (if (not (pair? d)) (list false (list "unknown-word" (lf-nth toks 0))) (if (not (equal (lf-cat d) "DET")) (list false (list "no-det")) (let ((nw (lf-entry (lf-nth toks 1)))) (if (not (pair? nw)) (list false (list "unknown-word" (lf-nth toks 1))) (if (not (and (equal (lf-cat nw) "N") (lf-unify (lf-num d) (lf-num nw)))) (list false (list "det-n-agree" (lf-nth toks 1))) (lf-check-verb (lf-nth toks 2) 3 (lf-num nw) toks 3)))))))))
(define-function lf-check (toks) (let ((n (lf-len toks))) (if (= n 0) (list false (list "empty")) (let ((subj (lf-entry (lf-nth toks 0)))) (if (not (pair? subj)) (list false (list "unknown-word" (lf-nth toks 0))) (if (equal (lf-cat subj) "PRON") (lf-check-pron-subj toks subj) (lf-check-np-subj toks)))))))
