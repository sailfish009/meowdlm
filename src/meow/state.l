;;; state.l — 학습 상태 저장/로드 + 사전 무결성 검증 + 원자적 커밋 (0.0051)
;;; primitives: file-stream/dump-all 직렬화, file-read-byte 로 FNV-1a 32 사전 검증,
;;;             file-replace 로 원자적 교체. 정수 판별은 long? (number? 없음).
(define *st-rules-fnv* 0)
(define *st-journal-fnv* 0)
(define *st-gen* 0)
(define *st-rules* ())
(define-function st-len-acc (xs a) (if (pair? xs) (st-len-acc (cdr xs) (+ a 1)) a))
(define-function st-len (xs) (st-len-acc xs 0))
(define *st-journal* ())
(define *st-fnv-init* 2166136261)
(define *st-fnv-prime* 16777619)
(define-function st-fnv-step (h b) (bitwise-and (* (bitwise-xor h b) *st-fnv-prime*) 4294967295))
(define-function st-fnv-file (path)
  (let ((f (file-open-read path)))
    (if (or (not f) (long? f)) ()
      (let ((h *st-fnv-init*))
        (let ((b 0))
          (while (set b (file-read-byte f))
            (set h (st-fnv-step h b))))
        (file-close f)
        h))))
;; ---- 저장: 페이로드를 임시 파일에 쓰고, 해시 계산 후 file-replace 로 교체
(define-function st-save-payload (path var value)
  (let* ((tmp (concat-string path ".tmp")) (f (file-open tmp "w")) (s (file-stream f)))
    (print-all s "(define ")
    (print-all s var)
    (print-all s " '")
    (dump-all s value)
    (print-all s ")\n")
    (file-close f)
    (file-replace tmp path)
    path))
(define-function st-save-pointer (path gen gh jh)
  (let* ((tmp (concat-string path ".tmp")) (f (file-open tmp "w")) (s (file-stream f)))
    (print-all s "(define *st-gen* ")
    (dump-all s gen)
    (print-all s ")\n(define *st-rules-fnv* ")
    (dump-all s gh)
    (print-all s ")\n(define *st-journal-fnv* ")
    (dump-all s jh)
    (print-all s ")\n")
    (file-close f)
    (file-replace tmp path)
    path))
(define-function st-dir (gen) (concat-string (concat-string "state/gen-" (integer->string gen)) "/"))
(define-function st-save (gen rules journal)
  (let* ((dir (st-dir gen)))
    (st-save-payload (concat-string dir "grammar.l") "*st-rules*" rules)
    (st-save-payload (concat-string dir "journal.l") "*st-journal*" journal)
    (let* ((gh (st-fnv-file (concat-string dir "grammar.l")))
           (jh (st-fnv-file (concat-string dir "journal.l"))))
      (st-save-pointer "state/pointer.l" gen gh jh)
      (list gh jh))))
;; ---- 로드: 해시 먼저 검증(불일치면 load 생략), 그 다음 load, 마지막 정규 재직렬화 대조
(define-function st-load (gen)
  (if (not (file-open-read "state/pointer.l")) (list "reject-nopointer")
   (begin
    (load "state/pointer.l")
  (if (not (= gen *st-gen*)) (list "reject-gen" gen *st-gen*)
    (let* ((dir (st-dir gen))
           (gpath (concat-string dir "grammar.l"))
           (jpath (concat-string dir "journal.l"))
           (gh (st-fnv-file gpath))
           (jh (st-fnv-file jpath)))
      (if (or (not (long? gh)) (not (long? jh))) (list "reject-missing" gpath jpath)
        (if (or (not (= gh *st-rules-fnv*)) (not (= jh *st-journal-fnv*))) (list "reject-hash" gh jh)
          (begin (load gpath) (load jpath)
                 (let* ((tmp "state/reser.tmp")
                        (f (file-open tmp "w")) (st (file-stream f)))
                   (print-all st "(define *st-rules* '")
                   (dump-all st *st-rules*)
                   (print-all st ")\n")
                   (file-close f)
                   (let ((rh (st-fnv-file tmp)))
                     (file-replace tmp (concat-string dir "reser.l"))
                     (if (= rh *st-rules-fnv*) (list "ok" (st-len *st-rules*) (st-len *st-journal*))
                       (list "reject-reser" rh *st-rules-fnv*))))))))))))
