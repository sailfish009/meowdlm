;;; certify.l — 도출 증명서(트리 IR) + 독립 검사기 + 반례 경로 (0.0050)
;;; 정의 순서 = 사용 순서, 모든 정의 한 줄.
(define-function c-nth (xs n) (if (= n 0) (car xs) (c-nth (cdr xs) (- n 1))))
(define-function c-len-acc (xs a) (if (pair? xs) (c-len-acc (cdr xs) (+ a 1)) a))
(define-function c-len (xs) (c-len-acc xs 0))
(define-function c-append (a b) (if (pair? a) (cons (car a) (c-append (cdr a) b)) b))
(define-function c-assoc (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (c-assoc k (cdr xs))) ()))
(define-function c-cat (nd) (c-nth nd 0))
(define-function c-num (nd) (c-nth nd 1))
(define-function c-casev (nd) (c-nth nd 2))
(define-function c-kids (nd) (c-nth nd 3))
(define-function c-leaf? (nd) (not (pair? (c-kids nd))))
(define-function c-unify (x y) (if (or (= x -1) (= y -1) (= x y)) true false))
(define-function c-lin-loop (stack acc) (if (pair? stack) (let ((x (car stack))) (if (c-leaf? x) (c-lin-loop (cdr stack) (c-append acc (list (c-cat x)))) (c-lin-loop (c-append (c-kids x) (cdr stack)) acc))) acc))
(define-function c-lin (nd) (c-lin-loop (list nd) ()))
(define-function c-contract (cat kids) (if (equal cat "S") (if (= 2 (c-len kids)) (c-unify (c-num (c-nth kids 0)) (c-num (c-nth kids 1))) true) (if (equal cat "NP") (if (= 2 (c-len kids)) (c-unify (c-num (c-nth kids 0)) (c-num (c-nth kids 1))) true) (if (equal cat "VP") (if (= 2 (c-len kids)) (if (equal (c-cat (c-nth kids 1)) "NP") (= 1 (c-casev (c-nth kids 1))) true) true) true))))
(define-function c-kids-path (ks path i) (if (pair? ks) (cons (list (car ks) (c-append path (list i))) (c-kids-path (cdr ks) path (+ i 1))) ()))
(define-function c-check-leaf (nd lex) (let* ((w (c-cat nd)) (e (c-assoc w lex))) (if (not (pair? e)) (list false (list "unknown-word" w)) (if (and (c-unify (c-nth e 2) (c-num nd)) (c-unify (c-nth e 3) (c-casev nd))) (list true ()) (list false (list "leaf-feature" w))))))
(define-function c-post (nd) (let ((cat (c-cat nd)) (kids (c-kids nd))) (if (equal cat "S") (c-unify (c-num nd) (c-num (c-nth kids 0))) (if (equal cat "NP") (c-unify (c-num nd) (c-num (c-nth kids 1))) (if (equal cat "VP") (c-unify (c-num nd) (c-num (c-nth kids 0))) true)))))
(define-function c-check-run (stack lex) (if (not (pair? stack)) (list true ()) (let* ((item (car stack)) (nd (c-nth item 0)) (path (c-nth item 1))) (if (c-leaf? nd) (let ((r (c-check-leaf nd lex))) (if (car r) (c-check-run (cdr stack) lex) (list false (c-nth r 1) path))) (if (c-contract (c-cat nd) (c-kids nd)) (if (c-post nd) (c-check-run (c-append (c-kids-path (c-kids nd) path 0) (cdr stack)) lex) (list false (list "post-feature" (c-cat nd)) path)) (list false (list "contract" (c-cat nd)) path))))))
(define-function c-check (nd lex) (c-check-run (list (list nd ())) lex))
(define-function c-mk-np (det dnum noun nnum) (list "NP" nnum -1 (list (list det dnum -1 ()) (list noun nnum -1 ()))))
(define-function c-mk-npo (det dnum noun nnum) (list "NP" nnum 1 (list (list det dnum -1 ()) (list noun nnum -1 ()))))
(define-function c-mk-vp1 (verb vnum) (list "VP" vnum -1 (list (list verb vnum -1 ()))))
(define-function c-mk-vp2 (verb vnum obj) (list "VP" vnum -1 (list (list verb vnum -1 ()) obj)))
(define-function c-mk-s (subj vp) (list "S" (c-num subj) -1 (list subj vp)))
(define-function c-gen-nps (ns acc) (if (pair? ns) (c-gen-nps (cdr ns) (c-append acc (list (c-mk-np "the" -1 (car ns) 0)))) acc))
(define-function c-gen-for (subj) (list (c-mk-s subj (c-mk-vp1 "chases" 0)) (c-mk-s subj (c-mk-vp2 "chases" 0 (c-mk-npo "a" 0 "dog" 0))) (c-mk-s subj (c-mk-vp1 "sleeps" 0))))
(define-function c-gen-trees (subjs) (if (pair? subjs) (c-append (c-gen-for (car subjs)) (c-gen-trees (cdr subjs))) ()))
(define-function c-mut-num (nd) (list (c-cat nd) (if (= (c-num nd) 0) 1 0) (c-casev nd) (c-kids nd)))
(define-function c-mut-leafnum (nd) (list (c-cat nd) (if (= (c-num nd) 0) 1 0) (c-casev nd) ()))