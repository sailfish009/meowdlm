(define *exp* ())
(define-function ex-nth (xs n) (if (= n 0) (car xs) (ex-nth (cdr xs) (- n 1))))
(define-function ex-len-acc (xs a) (if (pair? xs) (ex-len-acc (cdr xs) (+ a 1)) a))
(define-function ex-len (xs) (ex-len-acc xs 0))
(define-function ex-rev (xs acc) (if (pair? xs) (ex-rev (cdr xs) (cons (car xs) acc)) acc))
(define-function ex-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (ex-member? x (cdr xs))) false))
(define-function ex-assoc (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (ex-assoc k (cdr xs))) ()))
(define-function ex-clear () (set *exp* ()) true)
(define-function ex-add (kind key payload witness gate) (set *exp* (cons (list kind key payload witness gate) *exp*)) true)
(define-function ex-find-acc (kind key xs) (if (pair? xs) (let ((r (car xs))) (if (and (equal kind (ex-nth r 0)) (equal key (ex-nth r 1))) r (ex-find-acc kind key (cdr xs)))) ()))
(define-function ex-save (gen) (let* ((dir (concat-string (concat-string "state/gen-" (integer->string gen)) "/")) (path (concat-string dir "experience.l"))) (st-save-payload path "*exp*" *exp*) (st-fnv-file path)))
(define-function ex-load (gen) (let* ((dir (concat-string (concat-string "state/gen-" (integer->string gen)) "/")) (path (concat-string dir "experience.l"))) (load path) (list (st-fnv-file path) (ex-len *exp*))))
(define-function ex-kinds-acc (kind xs acc) (if (pair? xs) (ex-kinds-acc kind (cdr xs) (if (equal kind (ex-nth (car xs) 0)) (+ acc 1) acc)) acc))
(define-function ex-find (kind key) (ex-find-acc kind key *exp*))
(define-function ex-rejected? (key) (let ((r (ex-find "R" key))) (if (pair? r) (equal (ex-nth r 2) "reject") false)))
(define-function ex-kinds (kind acc) (if (pair? *exp*) (ex-kinds-acc kind *exp* acc) (ex-rev acc ())))
