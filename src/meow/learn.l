(define-function ln-nth (xs n) (if (= n 0) (car xs) (ln-nth (cdr xs) (- n 1))))
(define-function ln-len-acc (xs a) (if (pair? xs) (ln-len-acc (cdr xs) (+ a 1)) a))
(define-function ln-len (xs) (ln-len-acc xs 0))
(define-function ln-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (ln-member? x (cdr xs))) false))
(define-function ln-missing (cs0 cs1) (if (not (pair? cs0)) () (if (ln-member? (car cs0) cs1) (ln-missing (cdr cs0) cs1) (cons (car cs0) (ln-missing (cdr cs0) cs1)))))
(define-function ln-record-one (e b) (let* ((w (car e)) (cs0 (car (cdr e))) (cs1 (lx-cats w b))) (if (> (ln-len cs0) (ln-len cs1)) (begin (ex-add "L" w "removed" (ln-missing cs0 cs1) (list (ln-len cs0) (ln-len cs1))) true) true)))
(define-function ln-record-diff (a b) (if (not (pair? a)) true (begin (ln-record-one (car a) b) (ln-record-diff (cdr a) b))))
(define-function ln-prune-record (lex rules sents rounds floor) (let ((p (lx-prune lex rules sents rounds floor))) (ln-record-diff lex p) p))
(define-function ln-record-rule (key rule verdict dcov dshuf) (ex-add "R" key verdict rule (list dcov dshuf)))
