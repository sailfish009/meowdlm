(define *p-memo* ())
(define-function p-nth (xs n) (if (= n 0) (car xs) (p-nth (cdr xs) (- n 1))))
(define-function p-len-acc (xs a) (if (pair? xs) (p-len-acc (cdr xs) (+ a 1)) a))
(define-function p-len (xs) (p-len-acc xs 0))
(define-function p-rev (xs acc) (if (pair? xs) (p-rev (cdr xs) (cons (car xs) acc)) acc))
(define-function p-append (a b) (if (pair? a) (cons (car a) (p-append (cdr a) b)) b))
(define-function p-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (p-member? x (cdr xs))) false))
(define-function p-assoc (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (p-assoc k (cdr xs))) ()))
(define-function p-lhs (r) (p-nth r 0))
(define-function p-rhs (r) (p-nth r 1))
(define-function p-nonterm? (s rules) (if (pair? rules) (if (equal s (p-lhs (car rules))) true (p-nonterm? s (cdr rules))) false))
(define-function p-cats (w lex) (let ((e (p-assoc w lex))) (if (pair? e) (p-nth e 1) ())))
(define-function p-cats-of (toks lex) (if (pair? toks) (cons (p-cats (car toks) lex) (p-cats-of (cdr toks) lex)) ()))
(define-function p-rules-of (lhs rules acc) (if (pair? rules) (p-rules-of lhs (cdr rules) (if (equal lhs (p-lhs (car rules))) (cons (car rules) acc) acc)) (p-rev acc ())))
(define-function p-leaf (toks cats i cat) (if (p-member? cat (p-nth cats i)) (list "leaf" (p-nth toks i) cat) ()))
(define p-derive ())
(define p-seq ())
(define p-try-rules ())
