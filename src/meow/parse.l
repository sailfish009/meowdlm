(define-function p-seq-first (sym toks cats i m) (if (p-nonterm? sym *p-rules*) (p-derive sym toks cats i m) (if (= (+ i 1) m) (p-leaf toks cats i sym) ())))
(define-function p-seq-split (syms toks cats i j m) (if (>= m j) () (let ((a (p-seq-first (car syms) toks cats i m))) (if (pair? a) (let ((rest (p-seq (cdr syms) toks cats m j))) (if (pair? rest) (cons a rest) (p-seq-split syms toks cats i j (+ m 1)))) (p-seq-split syms toks cats i j (+ m 1))))))
(define-function p-seq (syms toks cats i j) (if (not (pair? syms)) (if (= i j) (list ()) ()) (if (> (p-len syms) 1) (p-seq-split syms toks cats i j (+ i 1)) (let ((one (p-seq-first (car syms) toks cats i j))) (if (pair? one) (list one) ())))))
(define-function p-derive (cat toks cats i j) (let* ((k (list cat i j)) (hit (p-assoc k *p-memo*))) (if (pair? hit) (p-nth hit 1) (let ((r (p-try-rules (p-rules-of cat *p-rules* ()) cat toks cats i j))) (set *p-memo* (cons (list k r) *p-memo*)) r))))
(define-function p-try-rules (rs cat toks cats i j) (if (pair? rs) (let ((k (p-seq (p-rhs (car rs)) toks cats i j))) (if (pair? k) (list "node" cat k) (p-try-rules (cdr rs) cat toks cats i j))) ()))
(define-function p-words (tr) (if (equal (p-nth tr 0) "leaf") (list (p-nth tr 1)) (p-words-all (p-nth tr 2) ())))
(define-function p-words-all (trees acc) (if (pair? trees) (p-words-all (cdr trees) (p-append acc (p-words (car trees)))) acc))
(define-function p-parse (tokens rules lex) (if (not (syn-accepts tokens rules lex)) () (begin (set *p-rules* rules) (set *p-memo* ()) (let ((cats (p-cats-of tokens lex))) (p-try-rules (p-rules-of "S" rules ()) "S" tokens cats 0 (p-len tokens))))))
