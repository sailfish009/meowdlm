(define-function ap-nth (xs n) (if (= n 0) (car xs) (ap-nth (cdr xs) (- n 1))))
(define-function ap-len-acc (xs a) (if (pair? xs) (ap-len-acc (cdr xs) (+ a 1)) a))
(define-function ap-len (xs) (ap-len-acc xs 0))
(define-function ap-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (ap-member? x (cdr xs))) false))
(define-function ap-cat-remove (cats cat) (if (not (pair? cats)) () (if (equal cat (car cats)) (ap-cat-remove (cdr cats) cat) (cons (car cats) (ap-cat-remove (cdr cats) cat)))))
(define-function ap-cats-removed (cs cats) (if (not (pair? cats)) cs (ap-cats-removed (ap-cat-remove cs (car cats)) (cdr cats))))
(define-function ap-rule-ok? (r) (if (not (pair? r)) false (if (not (string? (car r))) false (if (pair? (cdr r)) (pair? (car (cdr r))) false))))
(define-function ap-add-rule (rules r) (if (ap-rule-ok? r) (if (ap-member? r rules) rules (cons r rules)) rules))
(define-function ap-adopt-rules (exp rules) (if (not (pair? exp)) rules (let ((rec (car exp))) (if (and (equal (ap-nth rec 0) "R") (equal (ap-nth rec 2) "adopt")) (ap-adopt-rules (cdr exp) (ap-add-rule rules (ap-nth rec 3))) (ap-adopt-rules (cdr exp) rules)))))
(define-function ap-lex-remove (lex w cats) (if (not (pair? lex)) lex (if (equal w (car (car lex))) (cons (list w (ap-cats-removed (car (cdr (car lex))) cats)) (cdr lex)) (cons (car lex) (ap-lex-remove (cdr lex) w cats)))))
(define-function ap-union (a b) (if (not (pair? a)) b (ap-union (cdr a) (if (ap-member? (car a) b) b (cons (car a) b)))))
(define-function ap-lex-add (lex w cats) (if (not (pair? lex)) (list (list w cats)) (if (equal w (car (car lex))) (cons (list w (ap-union (car (cdr (car lex))) cats)) (cdr lex)) (cons (car lex) (ap-lex-add (cdr lex) w cats)))))
(define-function ap-apply-lex (exp lex) (if (not (pair? exp)) lex (let ((rec (car exp))) (if (and (equal (ap-nth rec 0) "L") (equal (ap-nth rec 2) "removed")) (ap-apply-lex (cdr exp) (ap-lex-remove lex (ap-nth rec 1) (ap-nth rec 3))) (if (and (equal (ap-nth rec 0) "L") (equal (ap-nth rec 2) "added")) (ap-apply-lex (cdr exp) (ap-lex-add lex (ap-nth rec 1) (ap-nth rec 3))) (ap-apply-lex (cdr exp) lex))))))
(define-function ap-build (exp base-rules base-lex) (list (ap-adopt-rules exp base-rules) (ap-apply-lex exp base-lex)))
