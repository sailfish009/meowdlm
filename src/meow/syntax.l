;;; syntax.l — 범주 격자 위 Earley 도출 (0.0047: 위치별 차트 고정점)
;;; 0.0040 결함 ④(전역 FIFO agenda 의 비-nullable 완료 누락)를 위치 순차 고정점으로 제거.
;;; 모든 정의는 한 줄, 정의 순서 = 사용 순서.
(define-function syn-nth (xs n) (if (= n 0) (car xs) (syn-nth (cdr xs) (- n 1))))
(define-function syn-len-acc (xs a) (if (pair? xs) (syn-len-acc (cdr xs) (+ a 1)) a))
(define-function syn-len (xs) (syn-len-acc xs 0))
(define-function syn-set-nth (xs n v) (if (= n 0) (cons v (cdr xs)) (cons (car xs) (syn-set-nth (cdr xs) (- n 1) v))))
(define-function syn-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (syn-member? x (cdr xs))) false))
(define-function syn-assoc (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (syn-assoc k (cdr xs))) ()))
(define-function syn-append (xs ys) (if (pair? xs) (cons (car xs) (syn-append (cdr xs) ys)) ys))
(define-function syn-rev (xs acc) (if (pair? xs) (syn-rev (cdr xs) (cons (car xs) acc)) acc))
(define-function syn-lhs (r) (syn-nth r 0))
(define-function syn-rhs (r) (syn-nth r 1))
(define-function syn-rlen (r) (syn-len (syn-rhs r)))
(define-function syn-nonterm? (sym rules) (if (pair? rules) (if (equal sym (syn-lhs (car rules))) true (syn-nonterm? sym (cdr rules))) false))
(define-function syn-rule-ids (lhs rules i acc) (if (pair? rules) (syn-rule-ids lhs (cdr rules) (+ i 1) (if (equal lhs (syn-lhs (car rules))) (cons i acc) acc)) (syn-rev acc ())))
(define-function syn-cats (w lex) (let ((e (syn-assoc w lex))) (if (pair? e) (syn-nth e 1) ())))
(define-function syn-filter-punct (toks acc) (if (pair? toks) (syn-filter-punct (cdr toks) (if (or (equal (car toks) ".") (equal (car toks) ",") (equal (car toks) "?") (equal (car toks) "!") (equal (car toks) ";")) acc (cons (car toks) acc))) (syn-rev acc ())))
(define-function syn-strip-punct (toks) (syn-filter-punct toks ()))
(define-function syn-cats-of (toks lex) (if (pair? toks) (cons (syn-cats (car toks) lex) (syn-cats-of (cdr toks) lex)) ()))
(define-function syn-blank (n) (if (> n 0) (cons () (syn-blank (- n 1))) (list ())))
(define-function syn-add (chart pos item) (if (syn-member? item (syn-nth chart pos)) chart (syn-set-nth chart pos (cons item (syn-nth chart pos)))))
(define-function syn-count (chart a) (if (pair? chart) (syn-count (cdr chart) (+ a (syn-len (car chart)))) a))
(define-function syn-waits-for? (it rules lhs) (let ((dot (syn-nth it 1)) (rhs (syn-rhs (syn-nth rules (syn-nth it 0))))) (if (< dot (syn-len rhs)) (equal (syn-nth rhs dot) lhs) false)))
(define-function syn-waiting (items rules lhs acc) (if (pair? items) (syn-waiting (cdr items) rules lhs (if (syn-waits-for? (car items) rules lhs) (cons (car items) acc) acc)) (syn-rev acc ())))
(define-function syn-advance (items acc) (if (pair? items) (syn-advance (cdr items) (cons (list (syn-nth (car items) 0) (+ 1 (syn-nth (car items) 1)) (syn-nth (car items) 2)) acc)) (syn-rev acc ())))
(define-function syn-add-many (chart pos items) (if (pair? items) (syn-add-many (syn-add chart pos (car items)) pos (cdr items)) chart))
(define-function syn-complete (chart rules cats n pos start lhs) (syn-add-many chart pos (syn-advance (syn-waiting (syn-nth chart start) rules lhs ()) ())))
(define-function syn-predict (chart rules cats n pos ids) (if (pair? ids) (syn-predict (syn-add chart pos (list (car ids) 0 pos)) rules cats n pos (cdr ids)) chart))
(define-function syn-step-at (chart rules cats n pos it) (let* ((ri (syn-nth it 0)) (dot (syn-nth it 1)) (start (syn-nth it 2)) (rhs (syn-rhs (syn-nth rules ri)))) (if (< dot (syn-len rhs)) (let ((sym (syn-nth rhs dot))) (if (syn-nonterm? sym rules) (syn-predict chart rules cats n pos (syn-rule-ids sym rules 0 ())) (if (< pos n) (if (syn-member? sym (syn-nth cats pos)) (syn-add chart (+ pos 1) (list ri (+ dot 1) start)) chart) chart))) (syn-complete chart rules cats n pos start (syn-lhs (syn-nth rules ri))))))
(define-function syn-sweep (chart rules cats n pos items) (if (pair? items) (syn-sweep (syn-step-at chart rules cats n pos (car items)) rules cats n pos (cdr items)) chart))
(define-function syn-close-at (chart rules cats n pos rounds) (if (= rounds 0) chart (let* ((before (syn-count chart 0)) (c2 (syn-sweep chart rules cats n pos (syn-nth chart pos)))) (if (= before (syn-count c2 0)) c2 (syn-close-at c2 rules cats n pos (- rounds 1))))))
(define-function syn-positions (chart rules cats n pos) (if (> pos n) chart (syn-positions (syn-close-at chart rules cats n pos 128) rules cats n (+ pos 1))))
(define-function syn-start (chart rules pos ids) (if (pair? ids) (syn-start (syn-add chart pos (list (car ids) 0 pos)) rules pos (cdr ids)) chart))
(define-function syn-goal-items? (items rules) (if (pair? items) (let ((it (car items))) (if (and (equal (syn-lhs (syn-nth rules (syn-nth it 0))) "S") (= (syn-nth it 1) (syn-rlen (syn-nth rules (syn-nth it 0)))) (= (syn-nth it 2) 0)) true (syn-goal-items? (cdr items) rules))) false))
(define-function syn-goal? (chart n rules) (syn-goal-items? (syn-nth chart n) rules))
(define-function syn-accepts (tokens rules lex) (let* ((n (syn-len tokens)) (cats (syn-cats-of tokens lex)) (c0 (syn-start (syn-blank n) rules 0 (syn-rule-ids "S" rules 0 ()))) (c1 (syn-positions c0 rules cats n 0))) (syn-goal? c1 n rules)))
(define-function syn-count-accepts (sents rules lex) (if (pair? sents) (+ (if (syn-accepts (car sents) rules lex) 1 0) (syn-count-accepts (cdr sents) rules lex)) 0))
