(define-function m-nth (xs n) (if (= n 0) (car xs) (m-nth (cdr xs) (- n 1))))
(define-function m-len-acc (xs a) (if (pair? xs) (m-len-acc (cdr xs) (+ a 1)) a))
(define-function m-len (xs) (m-len-acc xs 0))
(define-function m-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (m-member? x (cdr xs))) false))
(define-function m-chs (s i n) (if (< i n) (cons (string-at s i) (m-chs s (+ i 1) n)) ()))
(define-function m-drop (xs n) (if (= n 0) xs (if (pair? xs) (m-drop (cdr xs) (- n 1)) ())))
(define-function m-lastn (s n) (m-drop (m-chs s 0 (string-length s)) (- (string-length s) n)))
(define-function m-sfx? (s suf) (and (>= (string-length s) (m-len suf)) (equal (m-lastn s (m-len suf)) suf)))
