;;; agree.l — 자질(수·격) 강제 문법: 생성-선형화-검증 (Lean 4 예제의 Maru 대응, 0.0049)
;;; Lean 의존타입 대신 **자질 부착 + 통일 검사**로 같은 제약을 강제한다.
;;; 어휘 항목: (word cat number case)  number 0=단수 1=복수 -1=무관, case 0=주격 1=목적격 -1=무관
(define-function a-nth (xs n) (if (= n 0) (car xs) (a-nth (cdr xs) (- n 1))))
(define-function a-len-acc (xs a) (if (pair? xs) (a-len-acc (cdr xs) (+ a 1)) a))
(define-function a-len (xs) (a-len-acc xs 0))
(define-function a-member? (x xs) (if (pair? xs) (if (equal x (car xs)) true (a-member? x (cdr xs))) false))
(define-function a-assoc (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (a-assoc k (cdr xs))) ()))
(define-function a-rev (xs acc) (if (pair? xs) (a-rev (cdr xs) (cons (car xs) acc)) acc))
(define-function a-append (a b) (if (pair? a) (cons (car a) (a-append (cdr a) b)) b))
;; 어휘 (소형 폐쇄 집합; 수/격 자질 포함)
(define *lex* (list (list "the" "DET" -1 -1) (list "a" "DET" 0 -1)
                    (list "cat" "N" 0 -1) (list "dog" "N" 0 -1) (list "fish" "N" 0 -1)
                    (list "cats" "N" 1 -1) (list "dogs" "N" 1 -1)
                    (list "chases" "V" 0 -1) (list "eats" "V" 0 -1) (list "sleeps" "V" 0 -1)
                    (list "chase" "V" 1 -1) (list "eat" "V" 1 -1) (list "sleep" "V" 1 -1)
                    (list "i" "PRON" 0 0) (list "me" "PRON" 0 1) (list "they" "PRON" 1 0) (list "them" "PRON" 1 1)))
(define-function a-lookup (w) (a-assoc w *lex*))
(define-function a-cat (e) (a-nth e 1))
(define-function a-num (e) (a-nth e 2))
(define-function a-case (e) (a-nth e 3))
(define-function a-unify (x y) (if (or (= x -1) (= y -1) (= x y)) true false))
;; DET N 수 일치
(define-function a-np (toks i) (if (< (+ i 1) (a-len toks)) (let* ((d (a-lookup (a-nth toks i))) (n (a-lookup (a-nth toks (+ i 1))))) (if (and (pair? d) (pair? n) (equal (a-cat d) "DET") (equal (a-cat n) "N") (a-unify (a-num d) (a-num n))) (list (a-num n) (+ i 2)) ())) ()))
;; PRON 단독 NP
(define-function a-np-pron (toks i) (if (< i (a-len toks)) (let ((p (a-lookup (a-nth toks i)))) (if (and (pair? p) (equal (a-cat p) "PRON")) (list (a-num p) (+ i 1)) ())) ()))
(define-function a-np-any (toks i) (if (pair? (a-np toks i)) (a-np toks i) (a-np-pron toks i)))
;; VP: V(자동사) | V NP(타동사) — 주어 수와 동사 수 일치
(define-function a-vp (toks i subjnum) (if (< i (a-len toks)) (let ((v (a-lookup (a-nth toks i)))) (if (and (pair? v) (equal (a-cat v) "V") (a-unify (a-num v) subjnum)) (let ((after (+ i 1))) (if (= after (a-len toks)) (list after) (if (pair? (a-np toks after)) (list (a-nth (a-np toks after) 1)) ()))) ())) ()))
;; S -> NP VP (주어 수 = 동사 수)
(define-function a-s (toks) (let ((np (a-np-any toks 0))) (if (not (pair? np)) false (let ((after (a-nth np 1))) (if (not (pair? (a-vp toks after (a-nth np 0)))) false (if (= (a-nth (a-vp toks after (a-nth np 0)) 0) (a-len toks)) true false))))))
;; ---- 생성기: 트리 → 단어열 (Lean toWords 대응)
(define-function a-gen-np (num det noun) (list det noun))
(define-function a-gen-s (det noun verb obj) (if (pair? obj) (a-append (list det noun verb) obj) (list det noun verb)))
;; 후보 문장 집합에서 자질 검사 vs 무자질 검사 비교용
(define *fix* (list (list "the" "cat" "chases" "a" "dog") (list "the" "cats" "chase" "a" "dog")
                     (list "the" "cats" "chases" "a" "dog") (list "the" "cat" "chase" "a" "dog")
                     (list "a" "dog" "sleeps") (list "a" "dogs" "sleep") (list "a" "dogs" "sleeps")
                     (list "they" "sleep") (list "they" "sleeps") (list "i" "sleep") (list "me" "sleep")))
(define-function a-count (ss n) (if (pair? ss) (+ (if (a-s (car ss)) 1 0) (a-count (cdr ss) n)) 0))
(define-function a-emit (ss i) (if (pair? ss) (begin (print "F" i "|" (if (a-s (car ss)) "1" "0") "\n") (a-emit (cdr ss) (+ i 1))) ()))
