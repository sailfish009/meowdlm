;;; compare57_gate.l — 학습 반영 후 문법 커버리지/생성 통과 (게이트용, 가지치기 제외)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(load "data/surface_frames.l")
(load "data/surface_slots.l")
(load "data/surface_cats.l")
(define-function g-rv (xs acc) (if (pair? xs) (g-rv (cdr xs) (cons (car xs) acc)) acc))
(define-function g-sents (toks cur acc)
  (if (not (pair? toks)) (g-rv (if (pair? cur) (cons (g-rv cur ()) acc) acc) ())
    (if (equal (car toks) ".") (g-sents (cdr toks) () (if (pair? cur) (cons (g-rv cur ()) acc) acc))
      (g-sents (cdr toks) (cons (car toks) cur) acc))))
(define-function g-any (ss rules lex) (if (not (pair? ss)) false (if (syn-accepts (car ss) rules lex) true (g-any (cdr ss) rules lex))))
(define-function g-surf (cats rules lex acc)
  (if (not (pair? cats)) acc (let* ((s (s-realize (car cats) "probe" 2621440 *frames* *slots* 8)) (ss (g-sents (s-tokens s) () ())))
    (g-surf (cdr cats) rules lex (+ acc (if (g-any ss rules lex) 1 0))))))
(define *V2* (cons (list "S" (list "INTJ" "CL")) (cons (list "NG" (list "N" "CL")) (cons (list "VL" (list "AUX" "AUX" "V")) *rules*))))
(print "COV33 " (syn-count-accepts *corpus* *rules* *lexicon*) "/1000 surf=" (g-surf *cats* *rules* *lexicon* 0) "\n")
(print "COVV2 " (syn-count-accepts *corpus* *V2* *lexicon*) "/1000 surf=" (g-surf *cats* *V2* *lexicon* 0) "\n")
