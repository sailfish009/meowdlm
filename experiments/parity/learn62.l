;;; learn62.l — 학습 모듈 자동 기록 검증 (0.0062)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(define-function l62-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (l62-take (cdr xs) (- n 1))) ())))
(define *S40* (l62-take *corpus* 40))
(define *P* (ln-prune-record *lexicon* *rules* *S40* 2 1))
(print "AUTO-L " (ex-kinds "L" 0) " amb " (lx-total *lexicon* 0) "->" (lx-total *P* 0) " cov " (syn-count-accepts *S40* *rules* *lexicon*) "->" (syn-count-accepts *S40* *rules* *P*) "\n")
(ln-record-rule "NG->N CL" (list "NG" (list "N" "CL")) "adopt" 12 2)
(ln-record-rule "VP->AUX NP" (list "VP" (list "AUX" "NP")) "reject" 9 9)
(print "AUTO-R " (ex-kinds "R" 0) " rejected? " (if (ex-rejected? "VP->AUX NP") "1" "0") "\n")
(print "SAVE " (ex-save 3) "\n")
(ex-clear)
(print "RELOAD " (ex-load 3) "\n")
(print "RECORDS " (ex-len *exp*) " L=" (ex-kinds "L" 0) " R=" (ex-kinds "R" 0) "\n")
