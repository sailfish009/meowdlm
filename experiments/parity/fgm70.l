;;; fgm70.l — 6-슬롯 증명서 · 레이아웃 보존 변조 · 대조기 ablation (0.0070)
(load "data/lexfeat_data.l")
(load "src/meow/lexfeat.l")
(load "src/meow/fgw.l")
(load "src/meow/fgrammar.l")
(load "experiments/parity/fgdecl70b.l")

;; ---------- 문자열·리스트 ----------
(define f70-lin ())
(define f70-linkids ())
(define f70-rebuild ())
(define f70-rebuild-kids ())
(define-function f70-chs (s i n) (if (< i n) (cons (string-at s i) (f70-chs s (+ i 1) n)) ()))
(define-function f70-merge (a b) (if (pair? a) (cons (car a) (f70-merge (cdr a) b)) b))
(define-function f70-c2 (a b) (list->string (f70-merge (f70-chs a 0 (string-length a)) (f70-chs b 0 (string-length b)))))
(define-function f70-join (ws s) (if (pair? ws) (f70-join (cdr ws) (if (= 0 (string-length s)) (car ws) (f70-c2 s (f70-c2 " " (car ws))))) s))
(define-function f70-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (f70-take (cdr xs) (- n 1))) ())))
(define-function f70-mod (a b) (if (< a b) a (f70-mod (- a b) b)))
(define-function f70-nth (xs n) (if (= n 0) (car xs) (f70-nth (cdr xs) (- n 1))))
(define-function f70-appendl (a b) (if (pair? a) (cons (car a) (f70-appendl (cdr a) b)) b))

;; ---------- 트리 ----------
(define-function f70-linkids (kids) (if (not (pair? kids)) () (f70-appendl (f70-lin (car kids)) (f70-linkids (cdr kids)))))
(define-function f70-lin (t) (if (fg-leaf? t) (list (fg-leaf-word t)) (f70-linkids (fg-kids-of t))))
(define-function f70-rebuild-kids (kids f) (if (not (pair? kids)) () (cons (f70-rebuild (car kids) f) (f70-rebuild-kids (cdr kids) f))))

;; ---------- 측정 ----------
(define *GEN* (fg-gen-list 372 (fg-decl11)))
(define *TREES* (fg-tree-list 150 (fg-decl11)))
(define *CASES* (list (list "the" "box" "is" "mine") (list "the" "cats" "chase" "a" "dog") (list "the" "cat" "chases" "a" "dog") (list "the" "cat" "is" "mine") (list "the" "cat" "chases" "me") (list "the" "box" "are" "mine") (list "me" "sleep") (list "i" "sleep") (list "the" "cats" "chases" "a" "dog")))
(define-function f70-parcnt (i ok) (if (>= i 9) ok (f70-parcnt (+ i 1) (+ ok (if (equal (car (lf-check (f70-nth *CASES* i))) (fg-accept-gen (f70-nth *CASES* i) (fg-decl11))) 1 0)))))
(define-function f70-gcnt (ss ok) (if (not (pair? ss)) ok (f70-gcnt (cdr ss) (+ ok (if (car (lf-check (car ss))) 1 0)))))
(define-function f70-rt (ss ok) (if (not (pair? ss)) ok (f70-rt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11)) 1 0)))))
(define-function f70-tcnt (ts ok) (if (not (pair? ts)) ok (f70-tcnt (cdr ts) (+ ok (if (fg-chk-tree (car ts) (fg-decl11)) 1 0)))))
(define-function f70-lincnt (ts ok) (if (not (pair? ts)) ok (f70-lincnt (cdr ts) (+ ok (if (fg-accept-gen (f70-lin (car ts)) (fg-decl11)) 1 0)))))
(define-function f70-stride (xs k i acc) (if (not (pair? xs)) acc (f70-stride (cdr xs) k (+ i 1) (if (= 0 (f70-mod i k)) (cons (car xs) acc) acc))))
(define *SAMPLE* (f70-stride *GEN* 41 0 ()))

;; ---------- 변조 (6-슬롯 레이아웃 보존) ----------
(define-function f70-rebuild (t f)
  (if (not (pair? t)) t
    (if (fg-leaf? t) (f t)
      (list 'node (fg-tree-cat t) (car (cdr (cdr t))) (car (cdr (cdr (cdr t))))
            (fg-params-of t) (f70-rebuild-kids (fg-kids-of t) f)))))
(define-function f70-forge-tag (t) (cons 'BOGUS (cdr t)))
(define-function f70-forge-ifv (t) (if (fg-leaf? t) t
  (list 'node (fg-tree-cat t) (list (cons 'n 999) (cons 'p -42)) (fg-sem-of t) (fg-params-of t) (fg-kids-of t))))
(define-function f70-forge-none (t) (if (fg-leaf? t) t
  (list 'node (fg-tree-cat t) (list (cons 'n 'none) (cons 'p 'none)) (fg-sem-of t) (fg-params-of t) (fg-kids-of t))))
(define-function f70-forge-keydel (t) (if (fg-leaf? t) t
  (list 'node (fg-tree-cat t) (cdr (fg-ifv-of t)) (fg-sem-of t) (fg-params-of t) (fg-kids-of t))))
(define-function f70-forge-sem (t) (if (fg-leaf? t) t
  (list 'node (fg-tree-cat t) (fg-ifv-of t) (list 'clause 'FAKE) (fg-params-of t) (fg-kids-of t))))
(define-function f70-mut-leaf (leaf)
  (if (equal (fg-tree-cat leaf) 'N)
    (if (equal (fg-leaf-word leaf) "cats") (list 'leaf 'N "cat") (list 'leaf 'N "cats"))
    leaf))
(define-function f70-mut-ungram (leaf)
  (if (equal (fg-tree-cat leaf) 'N)
    (if (equal (fg-leaf-word leaf) "cats") (list 'leaf 'N "cat") (list 'leaf 'N "cats"))
    (if (equal (fg-tree-cat leaf) 'DET)
      (if (equal (fg-leaf-word leaf) "the") (list 'leaf 'DET "a") (list 'leaf 'DET "the"))
      leaf)))
;; 변조가 실제로 트리를 바꾼 경우만 센다 (공허한 팔 방지)
(define-function f70-mut-leaf-tree (t) (f70-rebuild t f70-mut-leaf))
(define-function f70-mut-ungram-tree (t) (f70-rebuild t f70-mut-ungram))
(define-function f70-neg (ts f ok mut)
  (if (not (pair? ts)) (list ok mut)
    (let* ((t (car ts)) (u (f t)))
      (if (equal t u) (f70-neg (cdr ts) f ok mut)
        (f70-neg (cdr ts) f (+ ok (if (fg-chk-tree u (fg-decl11)) 1 0)) (+ mut 1))))))
(define-function f70-neg1 (ts f) (f70-neg ts f 0 0))

;; ---------- 이빨 ----------
(define-function f70-3rd? (toks)
  (if (equal (lf-cat (lf-entry (f70-nth toks 0))) "DET") true
    (let ((p (lf-entry (f70-nth toks 0)))) (if (pair? p) (= (lf-person p) 3) false))))
(define-function f70-tscnt2 (ss ok) (if (not (pair? ss)) ok (f70-tscnt2 (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11-bad)) 1 0)))))
(define-function f70-sbad (ss n) (if (not (pair? ss)) n (f70-sbad (cdr ss) (if (and (f70-3rd? (car ss)) (fg-accept-gen (car ss) (fg-decl11-bad))) (+ n 1) n))))
(define-function f70-3sg? (toks)
  (if (equal (lf-cat (lf-entry (f70-nth toks 0))) "DET")
    (let ((n (lf-entry (f70-nth toks 1)))) (if (pair? n) (= (lf-num n) 0) false))
    (let ((p (lf-entry (f70-nth toks 0)))) (if (pair? p) (and (= (lf-person p) 3) (= (lf-num p) 0)) false))))
(define-function f70-np3sg? (toks)
  (if (equal (lf-cat (lf-entry (f70-nth toks 0))) "DET")
    (let ((n (lf-entry (f70-nth toks 1)))) (if (pair? n) (= (lf-num n) 0) false)) false))
(define-function f70-npbad (ss n) (if (not (pair? ss)) n (f70-npbad (cdr ss) (if (and (f70-np3sg? (car ss)) (fg-accept-gen (car ss) (fg-decl11-bad-sbj))) (+ n 1) n))))

;; ---------- COP ----------
(define-function f70-copk (ws) (if (not (pair? ws)) false (if (equal (lf-cat (lf-entry (car ws))) "COP") true (f70-copk (cdr ws)))))
(define-function f70-copcnt (ss n) (if (not (pair? ss)) n (f70-copcnt (cdr ss) (+ n (if (f70-copk (car ss)) 1 0)))))
(define-function f70-semshow (ts i) (if (and (pair? ts) (< i 3)) (begin (print "  SEM " (f70-join (f70-lin (car ts)) (list->string ())) " => " (fg-sem-of (car ts)) "\n") (f70-semshow (cdr ts) (+ i 1)))))

;; ---------- 출력 ----------
;; ---------- 결함 4: bind 순서 · 미등록 guard fail-closed ----------
(define-function f70-u1 () (list (list 'S (list 'NP)) (list 'NP '=> () (list 'DET (list 'n '$dn)) (list 'N (list 'n '$sn) (list 'bind '$sn 1)))))
(define-function f70-u2 () (list (list 'S (list 'NP)) (list 'NP '=> () (list 'DET (list 'n '$dn)) (list 'N (list 'bind '$sn 1) (list 'n '$sn)))))
(define-function f70-ug () (list (list 'S (list 'NP)) (list 'NP '=> () (list 'DET (list 'n '$dn)) (list 'N (list 'n '$sn) (list 'guard 'no-such-predicate '$sn '$sn)))))
(define-function f70-tf (x) (if x "true" "false"))
(print "BIND-ORDER u1-sing " (f70-tf (fg-accept-gen (list "the" "cat") (f70-u1))) " u2-sing " (f70-tf (fg-accept-gen (list "the" "cat") (f70-u2))) " u1-pl " (f70-tf (fg-accept-gen (list "the" "cats") (f70-u1))) " u2-pl " (f70-tf (fg-accept-gen (list "the" "cats") (f70-u2))) "\n")
(print "GUARD-UNREG " (f70-tf (fg-accept-gen (list "the" "cat") (f70-ug))) "\n")
(print "PARITY " (f70-parcnt 0 0) "/9\n")
(print "GEN all=" (fg-len *GEN*) " lf=" (f70-gcnt *GEN* 0) " rt=" (f70-rt *GEN* 0) "\n")
(print "CERT trees=" (fg-len *TREES*) " chk=" (f70-tcnt *TREES* 0) " lin-ok=" (f70-lincnt *TREES* 0) "\n")
(print "NEGMUT tag=" (f70-neg1 *TREES* f70-forge-tag) " ifv=" (f70-neg1 *TREES* f70-forge-ifv) " none=" (f70-neg1 *TREES* f70-forge-none) " keydel=" (f70-neg1 *TREES* f70-forge-keydel) " sem=" (f70-neg1 *TREES* f70-forge-sem) "\n")
(print "NEGDEEP leaf=" (f70-neg1 *TREES* f70-mut-leaf-tree) " ungram=" (f70-neg1 *TREES* f70-mut-ungram-tree) "\n")
(set *fg-ifv-check* 0)
(define F70-OFF (f70-neg1 *TREES* f70-forge-ifv))
(set *fg-ifv-check* 1)
(print "ABLATION off=" (car F70-OFF) "/" (car (cdr F70-OFF)) " on=" (car (f70-neg1 *TREES* f70-forge-ifv)) "\n")
(define-function f70-bscnt (ss ok) (if (not (pair? ss)) ok (f70-bscnt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11-bad-sbj)) 1 0)))))
(print "TEETH-S n=" (fg-len *SAMPLE*) " accepted=" (f70-tscnt2 *SAMPLE* 0) "\n")
(print "TEETH-S3 accepted3rd=" (f70-sbad *SAMPLE* 0) " total=" (fg-len *SAMPLE*) "\n")
(print "TEETH-SBJ np3sg-wrong=" (f70-npbad *SAMPLE* 0) "\n")
(print "COP-in-full-gen " (f70-copcnt *GEN* 0) "/" (fg-len *GEN*) "\n")
(f70-semshow *TREES* 0)
(define-function f70-copfind (ts i) (if (or (not (pair? ts)) (>= i 372)) () (if (f70-copk (f70-lin (car ts))) (car ts) (f70-copfind (cdr ts) (+ i 1)))))
(define-function f70-copshow (ts i) (if (pair? (f70-copfind ts i)) (print "  COPSEM " (f70-join (f70-lin (f70-copfind ts i)) (list->string ())) " => " (fg-sem-of (f70-copfind ts i)) "\n") (print "  COPSEM none\n")))
(define *TREESALL* (fg-tree-list 372 (fg-decl11)))
(f70-copshow *TREESALL* 0)
