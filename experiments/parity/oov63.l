;;; oov63.l — OOV 범주 가설(형태론·표제어)로 도출 상한 확장 (0.0063)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(load "data/lemma.l")
(define-function o-len (xs) (m-len xs))
(define-function o-rv (xs acc) (if (pair? xs) (o-rv (cdr xs) (cons (car xs) acc)) acc))
(define-function o-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (o-take (cdr xs) (- n 1))) ())))
(define-function o-in? (w lex) (if (pair? (syn-assoc w lex)) true false))
(define-function o-words (ws acc) (if (not (pair? ws)) acc (o-words (cdr ws) (if (o-in? (car ws) *lexicon*) acc (if (m-member? (car ws) acc) acc (cons (car ws) acc))))))
(define-function o-unknown (ss acc) (if (not (pair? ss)) acc (o-unknown (cdr ss) (o-words (car ss) acc))))
(define-function o-union (a b) (if (not (pair? a)) b (o-union (cdr a) (if (m-member? (car a) b) b (cons (car a) b)))))
(define-function o-from-lemma (l h) (if (pair? l) (if (o-in? (m-nth l 1) *lexicon*) (syn-nth (syn-assoc (m-nth l 1) *lexicon*) 1) h) h))
(define-function o-first (xs) (if (pair? xs) (list (car xs)) ()))
(define-function o-two (xs) (if (not (pair? xs)) () (if (pair? (cdr xs)) (list (car xs) (car (cdr xs))) (list (car xs)))))
(define-function o-cats (w mode) (let ((h (m-hyp w)) (l (syn-assoc w *lemma*))) (if (equal mode "morph") h (if (equal mode "one") (o-first h) (if (equal mode "two") (o-two h) (if (equal mode "lemma") (o-from-lemma l h) (o-union h (o-from-lemma l h))))))))
(define-function o-extend (ws lex mode) (if (not (pair? ws)) lex (o-extend (cdr ws) (cons (list (car ws) (o-cats (car ws) mode)) lex) mode)))
(define-function o-cov (ss rules lex ok) (if (not (pair? ss)) ok (o-cov (cdr ss) rules lex (+ ok (if (syn-accepts (car ss) rules lex) 1 0)))))
(define-function o-shuf (ss rules lex ok) (if (not (pair? ss)) ok (o-shuf (cdr ss) rules lex (+ ok (if (syn-accepts (o-rv (car ss) ()) rules lex) 1 0)))))
(define *UNK* (o-unknown *corpus* ()))
(define *S300* (o-take *corpus* 300))
(define *L-MORPH* (o-extend *UNK* *lexicon* "morph"))
(define *L-LEMMA* (o-extend *UNK* *lexicon* "lemma"))
(define *L-BOTH* (o-extend *UNK* *lexicon* "both"))
(define *L-ONE* (o-extend *UNK* *lexicon* "one"))
(define *L-TWO* (o-extend *UNK* *lexicon* "two"))
(print "UNK words=" (o-len *UNK*) " lex=" (o-len *lexicon*) "\n")
(print "A base   cov=" (o-cov *corpus* *rules* *lexicon* 0) " shuf=" (o-shuf *S300* *rules* *lexicon* 0) "\n")
(print "B morph  cov=" (o-cov *corpus* *rules* *L-MORPH* 0) " shuf=" (o-shuf *S300* *rules* *L-MORPH* 0) "\n")
(print "C lemma  cov=" (o-cov *corpus* *rules* *L-LEMMA* 0) " shuf=" (o-shuf *S300* *rules* *L-LEMMA* 0) "\n")
(print "E one    cov=" (o-cov *corpus* *rules* *L-ONE* 0) " shuf=" (o-shuf *S300* *rules* *L-ONE* 0) "\n")
(print "F two    cov=" (o-cov *corpus* *rules* *L-TWO* 0) " shuf=" (o-shuf *S300* *rules* *L-TWO* 0) "\n")
(print "D both   cov=" (o-cov *corpus* *rules* *L-BOTH* 0) " shuf=" (o-shuf *S300* *rules* *L-BOTH* 0) "\n")
