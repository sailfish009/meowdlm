;;; rules56.l — 누락 구조 규칙 증분 측정 (0.0056). surface는 문장 단위로 분리해 채점.
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(load "data/surface_frames.l")
(load "data/surface_slots.l")
(load "data/surface_cats.l")
(define-function w-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (w-take (cdr xs) (- n 1))) ())))
(define *S300* (w-take *corpus* 300))
(define-function w-rev (xs acc) (if (pair? xs) (w-rev (cdr xs) (cons (car xs) acc)) acc))
(define-function w-revcover (sents rules lex acc) (if (pair? sents) (w-revcover (cdr sents) rules lex (+ acc (if (syn-accepts (w-rev (car sents) ()) rules lex) 1 0))) acc))
;; 문장 분리: '.' 기준으로 토큰 목록을 나눈다
(define-function w-sents (toks cur acc)
  (if (not (pair? toks)) (w-rev (if (pair? cur) (cons (w-rev cur ()) acc) acc) ())
    (if (equal (car toks) ".") (w-sents (cdr toks) () (if (pair? cur) (cons (w-rev cur ()) acc) acc))
      (w-sents (cdr toks) (cons (car toks) cur) acc))))
(define-function w-any-ok (ss rules lex)
  (if (not (pair? ss)) false (if (syn-accepts (car ss) rules lex) true (w-any-ok (cdr ss) rules lex))))
(define-function w-surf (cats rules lex acc)
  (if (not (pair? cats)) acc
    (let* ((s (s-realize (car cats) "probe" 2621440 *frames* *slots* 8)) (ss (w-sents (s-tokens s) () ())))
      (w-surf (cdr cats) rules lex (+ acc (if (w-any-ok ss rules lex) 1 0))))))
(define-function report (label rules)
  (print label " cov=" (syn-count-accepts *S300* rules *lexicon*) " shuffle=" (w-revcover *S300* rules *lexicon* 0) " surf=" (w-surf *cats* rules *lexicon* 0) "\n"))
(define *C2* (list "VL" (list "AUX" "AUX" "V")))
(define *C7* (list "NG" (list "N" "CL")))
(define *C11* (list "S" (list "INTJ" "CL")))
(define *V2* (cons *C11* (cons *C7* (cons *C2* *rules*))))
(report "BASE33 " *rules*)
(report "V2     " *V2*)
