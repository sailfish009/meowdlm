;;; exp57.l — 경험 저장/재시작/기각 기억/반례 재생 (0.0057)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(load "data/lexfeat_data.l")
;; L: 소표본 가지치기 결과를 경험으로 남긴다
(define ex-take ())
(define-function ex-take-f (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (ex-take-f (cdr xs) (- n 1))) ())))
(define-function rec-one (e b) (let ((w (car e)) (c0 (ex-len (car (cdr e)))) (c1 (ex-len (lx-cats (car e) b)))) (if (> c0 c1) (ex-add "L" w "removed" c0 c1) true)))
(define-function rec-diff (a b) (if (pair? a) (begin (rec-one (car a) b) (rec-diff (cdr a) b)) true))
(define-function cex1 () (let ((r (lf-check (list "me" "sleep")))) (ex-add "C" "me sleep" (list "me" "sleep") (ex-nth r 1) "reject")))
(define-function cex2 () (let ((r (lf-check (list "the" "cats" "chases" "a" "dog")))) (ex-add "C" "cats chases" (list "the" "cats" "chases" "a" "dog") (ex-nth r 1) "reject")))
(define-function cex3 () (let ((r (lf-check (list "the" "cat" "is")))) (ex-add "C" "cat is" (list "the" "cat" "is") (ex-nth r 1) "reject")))
(define-function replay (rs ok) (if (not (pair? rs)) ok (let* ((r (car rs)) (toks (ex-nth r 2)) (now (ex-nth (lf-check toks) 1))) (replay (cdr rs) (+ ok (if (equal now (ex-nth r 3)) 1 0))))))
(define-function cex-all (xs acc) (if (pair? xs) (cex-all (cdr xs) (if (equal (ex-nth (car xs) 0) "C") (cons (car xs) acc) acc)) acc))
(define *TR30* (ex-take-f *corpus* 30))
(define *P* (lx-prune *lexicon* *rules* *TR30* 3 1))
(rec-diff *lexicon* *P*)
(ex-add "R" "VP->AUX NP" "reject" 9 9)
(ex-add "R" "NG->N CL" "adopt" 12 2)
(ex-add "R" "VL->AUX AUX V" "adopt" 2 0)
(cex1) (cex2) (cex3)
(print "EXP L=" (ex-kinds "L" 0) " R=" (ex-kinds "R" 0) " C=" (ex-kinds "C" 0) " total=" (ex-len *exp*) "\n")
(define *H* (ex-save 1))
(define *BEFORE* (ex-len *exp*))
(ex-clear)
(print "AFTER-CLEAR " (ex-len *exp*) "\n")
(print "RELOAD " (ex-load 1) " hash=" *H* "\n")
(print "RESUME-EQ " (if (= *BEFORE* (ex-len *exp*)) "1" "0") "\n")
(print "REJECT-MEM " (if (ex-rejected? "VP->AUX NP") "1" "0") " adopt-ok=" (if (ex-rejected? "NG->N CL") "0" "1") "\n")
(print "CEX-REPLAY " (replay (cex-all *exp* ()) 0) "/" (ex-kinds "C" 0) "\n")
