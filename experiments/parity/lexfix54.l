;;; lexfix54.l — 도출 보존 어휘 가지치기 (0.0054)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(define-function lx-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (lx-take (cdr xs) (- n 1))) ())))
(define *TR* (lx-take *corpus* 200))
(define-function lx-drop (xs n) (if (= n 0) xs (if (pair? xs) (lx-drop (cdr xs) (- n 1)) ())))
(define *HO* (lx-take (lx-drop *corpus* 200) 200))
(define-function lx-revcover (sents rules lex acc) (if (pair? sents) (lx-revcover (cdr sents) rules lex (+ acc (if (syn-accepts (lx-rev (car sents) ()) rules lex) 1 0))) acc))
(define *AMB0* (lx-total *lexicon* 0))
(define *MUL0* (lx-len (lx-multi *lexicon* ())))
(define *TR0* (syn-count-accepts *TR* *rules* *lexicon*))
(define *HO0* (syn-count-accepts *HO* *rules* *lexicon*))
(define *RV0* (lx-revcover *TR* *rules* *lexicon* 0))
(print "BEFORE amb=" *AMB0* " mult=" *MUL0* " train=" *TR0* "/200 held=" *HO0* "/200 rev=" *RV0* "\n")
(define *P* (lx-prune *lexicon* *rules* *TR* 6 1))
(define *AMB1* (lx-total *P* 0))
(define *MUL1* (lx-len (lx-multi *P* ())))
(define *TR1* (syn-count-accepts *TR* *rules* *P*))
(define *HO1* (syn-count-accepts *HO* *rules* *P*))
(define *RV1* (lx-revcover *TR* *rules* *P* 0))
(print "AFTER  amb=" *AMB1* " mult=" *MUL1* " train=" *TR1* "/200 held=" *HO1* "/200 rev=" *RV1* "\n")
(print "KEEP train=" (if (= *TR0* *TR1*) "1" "0") " held=" (if (>= *HO1* *HO0*) "1" "0") " rev=" (if (<= *RV1* *RV0*) "1" "0") "\n")
