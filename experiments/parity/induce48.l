;;; induce48.l — 재귀 붕괴 차단 + 셔플 음성 + held-out (0.0048)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(define *seed* (list (list "S" (list "CL")) (list "CL" (list "NP" "VP")) (list "CL" (list "VP")) (list "CL" (list "NP")) (list "NP" (list "DET" "NG")) (list "NP" (list "NG")) (list "NP" (list "PRON")) (list "NG" (list "N")) (list "NG" (list "A" "NG")) (list "NG" (list "N" "PP")) (list "VP" (list "V")) (list "VP" (list "V" "NP")) (list "VP" (list "V" "PP")) (list "PP" (list "PREP" "NP"))))
(define *TR* (g-take *corpus* 50))
(define *HO* (g-take (g-dropk *corpus* 50) 100))
(define-function rep (tag rules) (print tag " train=" (g-cover *TR* rules *lexicon* 0) "/50 held=" (g-cover *HO* rules *lexicon* 0) "/100 nons=" (g-nonsense-count rules *lexicon*) " shuf=" (g-shuffle-rej *TR* rules *lexicon* 0) "\n"))
(rep "SEED" *seed*)
(rep "FULL" *rules*)
(define *SCAP* (g-shuffle-rej *TR* *seed* *lexicon* 0))
(define *R* (g-loopH *seed* *TR* *lexicon* 0 10 2 *SCAP* ()))
(print "IND merges=" (car (cdr *R*)) " rules=" (g-len (car *R*)) "\n")
(rep "GAIN" (car *R*))
