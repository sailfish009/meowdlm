;;; oov_start.l — OOV 매핑 유무에 따른 판정 (타우 3단)
(load "data/ev.l")
(load "data/idf.l")
(load "data/probe_cues.l")
(load "data/probe.l")
(load "data/vocab.l")
(load "data/oov_vocab.l")
;; tau = 0.55 / 0.70 / 0.85 (Q16)
(define *t1* 36045)
(define *t2* 45875)
(define *t3* 55706)
(define-function d1 (cues i) (let ((r (e-decide cues () *ev-buckets* *idf-buckets* *vocab-buckets*))) (print "A" i "|" (e-nth r 0) "|" (e-nth r 1) "\n")))
(define-function dm (cues tau i tag) (let ((r (e-decide (o-map-cues cues *oov-vocab* tau ()) () *ev-buckets* *idf-buckets* *vocab-buckets*))) (print tag i "|" (e-nth r 0) "|" (e-nth r 1) "\n")))
(define-function emitm (cs tau i tag) (if (pair? cs) (begin (dm (car cs) tau i tag) (emitm (cdr cs) tau (+ i 1) tag)) ()))
(define-function emit (cs i) (if (pair? cs) (begin (d1 (car cs) i) (emit (cdr cs) (+ i 1))) ()))
(print "OOV probes=" (e-len *cue-lists*) " vocab=" (o-len *oov-vocab*) "\n")
(emit *cue-lists* 0)
(define-function u-dedupe (ts seen) (if (pair? ts) (if (o-member? (car ts) seen) (u-dedupe (cdr ts) seen) (cons (car ts) (u-dedupe (cdr ts) (cons (car ts) seen)))) ()))
(define-function dc (text tau i tag) (let* ((ug (u-dedupe (q-tokens text) ())) (mp (o-map-tokens ug *oov-vocab* tau ())) (r (e-decide mp () *ev-buckets* *idf-buckets* *vocab-buckets*))) (print tag i "|" (e-nth r 0) "|" (e-nth r 1) "\n")))
(define-function emitc (ps tau i tag) (if (pair? ps) (begin (dc (car ps) tau i tag) (emitc (cdr ps) tau (+ i 1) tag)) ()))
(emitc *probes* *t2* 0 "C70")
