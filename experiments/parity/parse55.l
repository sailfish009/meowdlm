;;; parse55.l — 트리 추출: 수용 파리티 + 트리 커버리지 + roundtrip + 모양 검사 (0.0055)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(define-function p-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (p-take (cdr xs) (- n 1))) ())))
(define p-shape-ok? ())
(define p-shape-all ())
(define *S* (p-take *corpus* 300))
(define-function p-shape-all (kids) (if (pair? kids) (if (p-shape-ok? (car kids)) (p-shape-all (cdr kids)) false) true))
(define-function p-shape-ok? (tr)
  (if (equal (p-nth tr 0) "leaf") true
    (let ((kids (p-nth tr 2)))
      (if (not (pair? kids)) false (p-shape-all kids)))))
(define-function cmp (ss accept trees rt shape)
  (if (not (pair? ss)) (list accept trees rt shape)
    (let* ((b (syn-accepts (car ss) *rules* *lexicon*)) (tr (p-parse (car ss) *rules* *lexicon*)) (t (equal (p-nth tr 0) "node")) (r (if (and t (equal (p-words tr) (car ss))) 1 0)) (sh (if (and t (p-shape-ok? tr)) 1 0)))
      (cmp (cdr ss) (+ accept (if b 1 0)) (+ trees (if t 1 0)) (+ rt r) (+ shape sh)))))
(define *C* (cmp *S* 0 0 0 0))
(print "ACCEPT " (p-nth *C* 0) "/300 trees=" (p-nth *C* 1) " roundtrip=" (p-nth *C* 2) " shape=" (p-nth *C* 3) "\n")
