;;; subst60.l — 연역적 구성 성분 정의(대체 가능성) 검증 (0.0060)
(load "data/syntax_lexicon.l")
(load "data/syntax_grammar.l")
(define-function sb-nth (xs n) (if (= n 0) (car xs) (sb-nth (cdr xs) (- n 1))))
(define-function sb-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (sb-take (cdr xs) (- n 1))) ())))
(define-function sb-drop (xs n) (if (= n 0) xs (if (pair? xs) (sb-drop (cdr xs) (- n 1)) ())))
(define-function sb-app (a b) (if (pair? a) (cons (car a) (sb-app (cdr a) b)) b))
(define-function sb-sub (toks i j rep) (sb-app (sb-app (sb-take toks i) rep) (sb-drop toks j)))
(define-function sb-chs (s i n) (if (< i n) (cons (string-at s i) (sb-chs s (+ i 1) n)) ()))
(define-function sb-mrg (a b) (if (pair? a) (cons (car a) (sb-mrg (cdr a) b)) b))
(define-function sb-c2 (a b) (list->string (sb-mrg (sb-chs a 0 (string-length a)) (sb-chs b 0 (string-length b)))))
(define-function sb-join (ws s) (if (pair? ws) (sb-join (cdr ws) (if (= 0 (string-length s)) (car ws) (sb-c2 s (sb-c2 " " (car ws))))) s))
(define-function sb-run (cs ok bad i)
  (if (not (pair? cs)) (list ok bad)
    (let* ((c (car cs)) (toks (sb-nth c 0)) (i0 (sb-nth c 1)) (j0 (sb-nth c 2)) (rep (sb-nth c 3)) (want (sb-nth c 4))
           (new (sb-sub toks i0 j0 rep))
           (got (if (syn-accepts new *rules* *lexicon*) "accept" "reject")))
      (if (equal got want) (sb-run (cdr cs) (+ ok 1) bad (+ i 1))
        (begin (print "  MISS " i " " (sb-join new (list->string ())) " want=" want " got=" got "\n") (sb-run (cdr cs) ok (+ bad 1) (+ i 1)))))))
(define *cases*
  (list (list (list "the" "box" "is" "mine") 0 2 (list "the" "cat") "accept")
        (list (list "the" "box" "is" "mine") 0 2 (list "a" "dog") "accept")
        (list (list "the" "cats" "chase" "a" "dog") 0 2 (list "the" "cat") "reject")
        (list (list "the" "cat" "chases" "a" "dog") 0 2 (list "the" "cats") "reject")
        (list (list "the" "cat" "chases" "a" "dog") 3 5 (list "the" "cats") "accept")
        (list (list "the" "cat" "chases" "a" "dog") 3 5 (list "me") "accept")
        (list (list "the" "cat" "chases" "a" "dog") 3 5 (list "i") "reject")
        (list (list "the" "box" "is" "mine") 2 4 (list "was" "mine") "accept")
        (list (list "the" "box" "is" "mine") 2 4 (list "are" "mine") "reject")))
(define-function sb-set (lex w cats) (if (not (pair? lex)) lex (if (equal w (car (car lex))) (cons (list w cats) (cdr lex)) (cons (car lex) (sb-set (cdr lex) w cats)))))
(define *LEX2* (sb-set (sb-set (sb-set *lexicon* "cat" (list "N")) "cats" (list "N")) "box" (list "N")))
(define *LEX3* (sb-set *LEX2* "mine" (list "N")))
(define *RULES3* (cons (list "VP" (list "AUX" "NP")) *rules*))
(define-function sb-run2 (cs ok bad i lex rls)
  (if (not (pair? cs)) (list ok bad)
    (let* ((c (car cs)) (toks (sb-nth c 0)) (i0 (sb-nth c 1)) (j0 (sb-nth c 2)) (rep (sb-nth c 3)) (want (sb-nth c 4))
           (new (sb-sub toks i0 j0 rep)) (got (if (syn-accepts new rls lex) "accept" "reject")))
      (if (equal got want) (sb-run2 (cdr cs) (+ ok 1) bad (+ i 1) lex rls) (sb-run2 (cdr cs) ok (+ bad 1) (+ i 1) lex rls)))))
(define *R* (sb-run *cases* 0 0 0))
(define *R2* (sb-run2 *cases* 0 0 0 *LEX2* *rules*))
(define *R3* (sb-run2 *cases* 0 0 0 *LEX3* *RULES3*))
(print "SUBST-REPAIR-L pass=" (sb-nth *R2* 0) " miss=" (sb-nth *R2* 1) "\n")
(print "SUBST-REPAIR-LR pass=" (sb-nth *R3* 0) " miss=" (sb-nth *R3* 1) "\n")
(load "data/syntax_corpus.l")
(print "SUBST pass=" (sb-nth *R* 0) " miss=" (sb-nth *R* 1) "\n")
