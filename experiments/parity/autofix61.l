;;; autofix61.l — 반례 표적 최소 수정(어휘 + 규칙) 루프 (0.0061)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(define-function af-nth (xs n) (if (= n 0) (car xs) (af-nth (cdr xs) (- n 1))))
(define-function af-len-acc (xs a) (if (pair? xs) (af-len-acc (cdr xs) (+ a 1)) a))
(define-function af-len (xs) (af-len-acc xs 0))
(define-function af-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (af-take (cdr xs) (- n 1))) ())))
(define-function af-append (a b) (if (pair? a) (cons (car a) (af-append (cdr a) b)) b))
(define-function af-set (lex w cats) (if (not (pair? lex)) lex (if (equal w (car (car lex))) (cons (list w cats) (cdr lex)) (cons (car lex) (af-set (cdr lex) w cats)))))
(define-function af-pairs1 (w sets acc) (if (not (pair? sets)) acc (af-pairs1 w (cdr sets) (cons (list "lex" w (car sets)) acc))))
(define-function af-pairs (ws sets acc) (if (not (pair? ws)) acc (af-pairs (cdr ws) sets (af-pairs1 (car ws) sets acc))))
(define-function af-apply (c lex rls)
  (if (equal (af-nth c 0) "lex")
    (list (af-set lex (af-nth c 1) (af-nth c 2)) rls)
    (list lex (cons (af-nth c 1) rls))))
(define *CASES* (list (list "the" "box" "is" "mine") (list "the" "cats" "chase" "a" "dog") (list "the" "cat" "chases" "a" "dog") (list "the" "cat" "is" "mine") (list "the" "cat" "chases" "me") (list "the" "box" "are" "mine") (list "me" "sleep") (list "i" "sleep") (list "the" "cats" "chases" "a" "dog")))
(define *WORDS* (list "the" "box" "is" "mine" "cats" "chase" "a" "dog" "cat" "chases" "me" "are" "sleep" "i"))
(define *SETS* (list (list "N") (list "V") (list "A") (list "N" "V") (list "N" "A") (list "PRON") (list "AUX") (list "DET") (list "N" "A" "V")))
(define *OOVS* (list (list "lex" "warm" (list "A"))))
(define *RULEC* (list (list "rule" (list "VP" (list "AUX" "NP"))) (list "rule" (list "VP" (list "AUX" "A"))) (list "rule" (list "S" (list "INTJ" "CL"))) (list "rule" (list "NG" (list "N" "CL"))) (list "rule" (list "VL" (list "AUX" "AUX" "V"))) (list "rule" (list "CL" (list "PP" "CL")))))
(define *CANDS* (af-append (af-pairs *WORDS* *SETS* ()) *RULEC*))
(define *S60* (af-take *corpus* 60))
(define-function af-target (toks) (if (car (lf-check toks)) true false))
(define-function af-agree (lex rls i ok) (if (>= i (af-len *CASES*)) ok (let ((t (af-nth *CASES* i))) (af-agree lex rls (+ i 1) (+ ok (if (equal (af-target t) (syn-accepts t rls lex)) 1 0))))))
(define-function af-cov (lex rls ss ok) (if (not (pair? ss)) ok (af-cov lex rls (cdr ss) (+ ok (if (syn-accepts (car ss) rls lex) 1 0)))))
(define-function af-correct (lex rls i acc) (if (>= i (af-len *CASES*)) acc (let ((t (af-nth *CASES* i))) (if (equal (af-target t) (syn-accepts t rls lex)) (af-correct lex rls (+ i 1) (cons i acc)) (af-correct lex rls (+ i 1) acc)))))
(define-function af-keep? (lex rls idxs) (if (not (pair? idxs)) true (let ((t (af-nth *CASES* (car idxs)))) (if (equal (af-target t) (syn-accepts t rls lex)) (af-keep? lex rls (cdr idxs)) false))))
(define-function af-fix-case (lex rls i want idxs cands)
  (if (not (pair? cands)) ()
    (let* ((c (car cands)) (ap (af-apply c lex rls)) (lex2 (af-nth ap 0)) (rls2 (af-nth ap 1)))
      (if (and (equal (syn-accepts (af-nth *CASES* i) rls2 lex2) want) (af-keep? lex2 rls2 idxs)) c (af-fix-case lex rls i want idxs (cdr cands))))))
(define-function af-loop (lex rls i cov0 n)
  (if (or (>= i (af-len *CASES*)) (>= n 4)) (list lex rls n)
    (let* ((t (af-nth *CASES* i)) (want (af-target t)))
      (if (equal want (syn-accepts t rls lex)) (af-loop lex rls (+ i 1) cov0 n)
        (let* ((idxs (af-correct lex rls 0 ())) (c (af-fix-case lex rls i want idxs *CANDS*)))
          (if (not (pair? c)) (af-loop lex rls (+ i 1) cov0 n)
            (let* ((ap (af-apply c lex rls)) (lex2 (af-nth ap 0)) (rls2 (af-nth ap 1)))
              (if (>= (af-cov lex2 rls2 *S60* 0) cov0)
                (begin (print "  FIX " c " (case " i ", agree=" (af-agree lex2 rls2 0 0) ", cov=" (af-cov lex2 rls2 *S60* 0) ")\n") (af-loop lex2 rls2 (+ i 1) cov0 (+ n 1)))
                (af-loop lex rls (+ i 1) cov0 n)))))))))
(define *A0* (af-agree *lexicon* *rules* 0 0))
(define *C0* (af-cov *lexicon* *rules* *S60* 0))
(print "START agree=" *A0* "/9 cov=" *C0* "/60 cands=" (af-len *CANDS*) "\n")
(define *R* (af-loop *lexicon* *rules* 0 *C0* 0))
(print "FINAL agree=" (af-agree (af-nth *R* 0) (af-nth *R* 1) 0 0) "/9 cov=" (af-cov (af-nth *R* 0) (af-nth *R* 1) *S60* 0) "/60 adopted=" (af-nth *R* 2) "\n")
