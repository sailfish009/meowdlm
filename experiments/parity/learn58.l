;;; learn58.l — 학습 실행: 가지치기(L) + 규칙 채택(R) → 경험 저장 → 적용 (0.0058)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(define-function lr-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (lr-take (cdr xs) (- n 1))) ())))
(define-function lr-missing (cs0 cs1) (if (not (pair? cs0)) () (if (ap-member? (car cs0) cs1) (lr-missing (cdr cs0) cs1) (cons (car cs0) (lr-missing (cdr cs0) cs1)))))
(define-function lr-one (e b) (let* ((w (car e)) (cs0 (car (cdr e))) (cs1 (lx-cats w b))) (if (> (ap-len cs0) (ap-len cs1)) (begin (ex-add "L" w "removed" (lr-missing cs0 cs1) (list (ap-len cs0) (ap-len cs1))) true) true)))
(define-function lr-diff (a b) (if (not (pair? a)) true (begin (lr-one (car a) b) (lr-diff (cdr a) b))))
(define *TR200* (lr-take *corpus* 200))
(define *P33* (lx-prune *lexicon* *rules* *TR200* 3 1))
(lr-diff *lexicon* *P33*)
(ex-add "R" "S->INTJ CL" "adopt" (list "S" (list "INTJ" "CL")) (list 0 0))
(ex-add "R" "NG->N CL" "adopt" (list "NG" (list "N" "CL")) (list 12 2))
(ex-add "R" "VL->AUX AUX V" "adopt" (list "VL" (list "AUX" "AUX" "V")) (list 2 0))
(ex-add "R" "VP->AUX NP" "reject" (list "VP" (list "AUX" "NP")) (list 9 9))
(print "LEARN L=" (ex-kinds "L" 0) " R=" (ex-kinds "R" 0) "\n")
(print "SAVE " (ex-save 2) "\n")
(define *AP* (ap-build *exp* *rules* *lexicon*))
(print "APPLY rules=" (ap-len (ap-nth *AP* 0)) " amb-before=" (lx-total *lexicon* 0) " amb-after=" (lx-total (ap-nth *AP* 1) 0) "\n")
(define-function lr-first-L (xs n) (if (not (pair? xs)) () (if (and (equal (ap-nth (car xs) 0) "L") (> n 0)) (begin (print "  L: " (car xs) "\n") (lr-first-L (cdr xs) (- n 1))) (lr-first-L (cdr xs) n))))
(lr-first-L *exp* 2)
(print "COV-BASE    " (syn-count-accepts *corpus* *rules* *lexicon*) "/1000\n")
(print "COV-APPLIED " (syn-count-accepts *corpus* (ap-nth *AP* 0) (ap-nth *AP* 1)) "/1000\n")
