        (list 'V (list 'p '$vp) (list 'n '$vn) (list 'guard 'agree '$vp '$vn '$sp1 '$sn1)))))
;; 동일 비단말 재사용 선언
(define-function fg-decl-dup () (list
  (list 'S (list 'Obj (list 'n '$a)) (list 'CONJ) (list 'Obj (list 'n '$b)))
  (list 'Obj '=> (list (list 'n '$dn2)) (list 'DET (list 'n '$dn2)) (list 'N (list 'n '$dn2)))))
;; 문자열
(define-function f69-chs (s i n) (if (< i n) (cons (string-at s i) (f69-chs s (+ i 1) n)) ()))
(define-function f69-merge (a b) (if (pair? a) (cons (car a) (f69-merge (cdr a) b)) b))
(define-function f69-c2 (a b) (list->string (f69-merge (f69-chs a 0 (string-length a)) (f69-chs b 0 (string-length b)))))
(define-function f69-join (ws s) (if (pair? ws) (f69-join (cdr ws) (if (= 0 (string-length s)) (car ws) (f69-c2 s (f69-c2 " " (car ws))))) s))
(define-function f69-nth (xs n) (if (= n 0) (car xs) (f69-nth (cdr xs) (- n 1))))
(define-function f69-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (f69-take (cdr xs) (- n 1))) ())))
(define-function f69-mod (a b) (if (< a b) a (f69-mod (- a b) b)))
(define-function f69-stride (xs k i acc) (if (not (pair? xs)) acc (f69-stride (cdr xs) k (+ i 1) (if (= 0 (f69-mod i k)) (cons (car xs) acc) acc))))
(define-function f69-gcnt (ss ok) (if (not (pair? ss)) ok (f69-gcnt (cdr ss) (+ ok (if (car (lf-check (car ss))) 1 0)))))
(define-function f69-rt (ss ok) (if (not (pair? ss)) ok (f69-rt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11)) 1 0)))))
(define-function f69-tcnt (ts ok) (if (not (pair? ts)) ok (f69-tcnt (cdr ts) (+ ok (if (fg-chk-tree (car ts) (fg-decl11)) 1 0)))))
(define-function f69-appendl (a b) (if (pair? a) (cons (car a) (f69-appendl (cdr a) b)) b))
(define-function f69-lin (t) (if (fg-leaf? t) (list (car (cdr (cdr t)))) (f69-linkids (fg-kids-of t))))
(define-function f69-linkids (kids) (if (not (pair? kids)) () (f69-appendl (f69-lin (car kids)) (f69-linkids (cdr kids)))))
(define-function f69-lincnt (ts ok) (if (not (pair? ts)) ok (f69-lincnt (cdr ts) (+ ok (if (fg-accept-gen (f69-lin (car ts)) (fg-decl11)) 1 0)))))
(define-function f69-linshow (ts i) (if (pair? ts) (begin (print "  lin " i " " (f69-join (f69-lin (car ts)) (list->string ())) "\n") (f69-linshow (cdr ts) (+ i 1)))))
(define-function f69-tscnt (ss ok) (if (not (pair? ss)) ok (f69-tscnt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11-bad)) 1 0)))))

(define p69-one ())
