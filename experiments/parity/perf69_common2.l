(define *CASES9* (list (list "the" "box" "is" "mine") (list "the" "cats" "chase" "a" "dog") (list "the" "cat" "chases" "a" "dog") (list "the" "cat" "is" "mine") (list "the" "cat" "chases" "me") (list "the" "box" "are" "mine") (list "me" "sleep") (list "i" "sleep") (list "the" "cats" "chases" "a" "dog")))
(define IDX9 (fg-index (fg-decl11)))
(define-function p69-one (ss) (if (not (pair? ss)) 0 (+ (p69-acc (car ss)) (p69-one (cdr ss)))))
(define-function p69-loop (rounds) (if (= rounds 0) 0 (+ (p69-one *CASES9*) (p69-loop (- rounds 1)))))
