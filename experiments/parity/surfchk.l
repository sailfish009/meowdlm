(load "data/syntax_grammar.l")
(load "data/syntax_lexicon.l")
(load "data/surface_frames.l")
(load "data/surface_slots.l")
(load "data/surface_cats.l")
(define-function chk1 (cat i) (let* ((s (s-realize cat "probe" 2621440 *frames* *slots* 8)) (ws (s-tokens s))) (print "K" i "|" (if (syn-accepts ws *rules* *lexicon*) "1" "0") "|" cat "\n")))
(define-function chk (cs i) (if (pair? cs) (begin (chk1 (car cs) i) (chk (cdr cs) (+ i 1))) ()))
(print "CHK n=" (s-len *cats*) "\n")
(chk *cats* 0)
