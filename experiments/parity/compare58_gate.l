;;; compare58_gate.l — 저장된 경험(규칙 R + 어휘 L)을 적용한 상태로 측정 (0.0058)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(load "data/surface_frames.l")
(load "data/surface_slots.l")
(load "data/surface_cats.l")
(define-function g-rv (xs acc) (if (pair? xs) (g-rv (cdr xs) (cons (car xs) acc)) acc))
(define-function g-sents (toks cur acc) (if (not (pair? toks)) (g-rv (if (pair? cur) (cons (g-rv cur ()) acc) acc) ()) (if (equal (car toks) ".") (g-sents (cdr toks) () (if (pair? cur) (cons (g-rv cur ()) acc) acc)) (g-sents (cdr toks) (cons (car toks) cur) acc))))
(define-function g-any (ss rules lex) (if (not (pair? ss)) false (if (syn-accepts (car ss) rules lex) true (g-any (cdr ss) rules lex))))
(define-function g-surf (cats rules lex acc) (if (not (pair? cats)) acc (let* ((s (s-realize (car cats) "probe" 2621440 *frames* *slots* 8)) (ss (g-sents (s-tokens s) () ()))) (g-surf (cdr cats) rules lex (+ acc (if (g-any ss rules lex) 1 0))))))
(define *LOAD* (ex-load 2))
(define *AP* (ap-build *exp* *rules* *lexicon*))
(define *R2* (ap-nth *AP* 0))
(define *L2* (ap-nth *AP* 1))
(print "STATE records=" (ap-nth *LOAD* 1) " rules=" (ap-len *R2*) " amb=" (lx-total *L2* 0) "\n")
(print "COV-BASE " (syn-count-accepts *corpus* *rules* *lexicon*) "/1000 surf=" (g-surf *cats* *rules* *lexicon* 0) "\n")
(print "COV-EXP  " (syn-count-accepts *corpus* *R2* *L2*) "/1000 surf=" (g-surf *cats* *R2* *L2* 0) "\n")
