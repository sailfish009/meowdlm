;;; fgm64.l — 단일 자질문법 선언 → 인식기·생성기 동시 전개 파일럿 (0.0064)
(load "data/lexfeat_data.l")
(load "src/meow/lexfeat.l")
(load "src/meow/fgw.l")
(load "src/meow/fgrammar.l")
;; 단일 선언 (유일한 문법 원천): 규칙 = (범주 (아이범주 제약...)...)
;;   제약 (f 변수|리터럴)  특질 f = p 인칭 / n 수 / c 격 / v 논항가
;;        (bind 변수 리터럴)  비단말 인터페이스 자질 고정
;;        (guard 술어 변수...) 명명 술어 (intr, tr, agree)
(define *fg-decl* (list
  (list 'S '=> (list (list 'n '$sn1) (list 'p '$sp1))
        (list 'Sbj (list 'n '$sn1) (list 'p '$sp1)) (list 'VPred (list 'n '$sn1) (list 'p '$sp1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1 3))
        (list 'DET (list 'n '$sn1)) (list 'N (list 'n '$sn1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1) (list 'c '$sc1))
        (list 'PRON (list 'n '$sn1) (list 'p '$sp1) (list 'c 0)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1))
        (list 'V (list 'v '$v1) (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'intr '$v1 '$v1) (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1))
        (list 'V (list 'v '$v1) (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'tr '$v1 '$v1) (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1))
        (list 'Obj))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1))
        (list 'COP (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1))
        (list 'Comp))
  (list 'Obj '=> (list (list 'n '$dn2))
        (list 'DET (list 'n '$dn2)) (list 'N (list 'n '$dn2)))
  (list 'Obj (list 'PRON (list 'c 1)))
  (list 'Comp (list 'A)) (list 'Comp (list 'PREP)) (list 'Comp (list 'Obj))))
(def-fg *fg-pilot*)
(define-function fg-accept (toks) (if (pair? (fg-accept-alts toks)) true false))
(define-function fg-gen (n) (fg-gen-list n))
;; 문자열 결합 (Maru 에는 string-append 가 없어 문자코드 병합)
(define-function f64-chs (s i n) (if (< i n) (cons (string-at s i) (f64-chs s (+ i 1) n)) ()))
(define-function f64-merge (a b) (if (pair? a) (cons (car a) (f64-merge (cdr a) b)) b))
(define-function f64-c2 (a b) (list->string (f64-merge (f64-chs a 0 (string-length a)) (f64-chs b 0 (string-length b)))))
(define-function f64-join (ws s) (if (pair? ws) (f64-join (cdr ws) (if (= 0 (string-length s)) (car ws) (f64-c2 s (f64-c2 " " (car ws))))) s))
(define-function f64-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (f64-take (cdr xs) (- n 1))) ())))
;; 인식기 진입
(define-function f64-done (alts) (if (not (pair? alts)) () (if (pair? (cdr (car alts))) (f64-done (cdr alts)) (list true))))
(define-function fg-accept (toks) (if (pair? (f64-done (fg-mcat 'S (fg-nilsub) toks *fg-decl*))) true false))
;; 생성기 진입
(define-function f64-nows (alts) (if (not (pair? alts)) () (if (pair? (car (cdr (car alts)))) (cons (car (cdr (car alts))) (f64-nows (cdr alts))) (f64-nows (cdr alts)))))
(define-function f64-pick (alts n) (f64-take (f64-nows alts) n))
;; 9개 판정 대조
(define *CASES* (list (list "the" "box" "is" "mine") (list "the" "cats" "chase" "a" "dog") (list "the" "cat" "chases" "a" "dog") (list "the" "cat" "is" "mine") (list "the" "cat" "chases" "me") (list "the" "box" "are" "mine") (list "me" "sleep") (list "i" "sleep") (list "the" "cats" "chases" "a" "dog")))
(define-function f64-cnt (i ok) (if (>= i 9) ok (f64-cnt (+ i 1) (+ ok (if (equal (car (lf-check (fg-nth *CASES* i))) (fg-accept (fg-nth *CASES* i))) 1 0)))))
(define-function f64-print (i) (if (< i 9) (begin (print "  case " i " " (f64-join (fg-nth *CASES* i) (list->string ())) " lf=" (if (car (lf-check (fg-nth *CASES* i))) "A" "R") " decl=" (if (fg-accept (fg-nth *CASES* i)) "A" "R") "\n") (f64-print (+ i 1)))))
;; 생성: 선언에서 문장을 만들고 독립 검사기 lf-check 로 채점
(define *GEN* (f64-pick (fg-gcat 'S (fg-nilsub) *fg-decl*) 400))
(define-function f64-gcnt (ss ok) (if (not (pair? ss)) ok (f64-gcnt (cdr ss) (+ ok (if (car (lf-check (car ss))) 1 0)))))
(define-function f64-gprint (ss i) (if (pair? ss) (begin (print "  gen " i " " (f64-join (car ss) (list->string ())) " lf=" (if (car (lf-check (car ss))) "A" "R") "\n") (f64-gprint (cdr ss) (+ i 1)))))
(define *fg-decl-bad* (list
  (list 'S '=> (list (list 'n '$sn1) (list 'p '$sp1 1))
        (list 'Sbj (list 'n '$sn1) (list 'p '$sp1)) (list 'VPred (list 'n '$sn1) (list 'p '$sp1)))
  (list 'Sbj (list 'DET (list 'n '$sn1)) (list 'N (list 'n '$sn1)))
  (list 'VPred (list 'V (list 'n '$sn1) (list 'p '$sp1)))
  (list 'Obj (list 'PRON (list 'c 1)))))
(define *fg-decl-00* *fg-decl*)
(define-function f66-teeth (toks)
  (let ((keep *fg-decl*))
    (set *fg-decl* *fg-decl-bad*)
    (let ((r (fg-accept-gen toks)))
      (set *fg-decl* keep)
      r)))
(define-function f66-tcnt (ss ok) (if (not (pair? ss)) ok (f66-tcnt (cdr ss) (+ ok (if (f66-teeth (car ss)) 1 0)))))
(print "DECL rules=" (fg-len *fg-decl*) " lexicon=" (fg-len *lf-lex*) "\n")
(print "PARITY decl vs lf-check = " (f64-cnt 0 0) "/9\n")
(f64-print 0)
(define-function f64-mod (a b) (if (< a b) a (f64-mod (- a b) b)))
(define-function f64-stride (xs k i acc) (if (not (pair? xs)) acc (f64-stride (cdr xs) k (+ i 1) (if (= 0 (f64-mod i k)) (cons (car xs) acc) acc))))
(define-function f64-rt (ss ok) (if (not (pair? ss)) ok (f64-rt (cdr ss) (+ ok (if (fg-accept (car ss)) 1 0)))))
(define *SAMPLE* (f64-stride *GEN* 17 0 ()))
(print "GEN all=" (fg-len *GEN*) " lf-accept=" (f64-gcnt *GEN* 0) " roundtrip=" (f64-rt *GEN* 0) "/" (fg-len *GEN*) "\n")
(print "SAMPLE=" (fg-len *SAMPLE*) "\n")
(print "TEETH n=" (fg-len *SAMPLE*) " accepted-with-wrong-default=" (f66-tcnt *SAMPLE* 0) "\n")
;; 두 번째 이빨: 자식이 3인칭을 바인딩했는데 부모 기본값이 1이면 값 검사가 거부해야 한다
(define *fg-decl-bad2* (list
  (list 'S '=> (list (list 'n '$sn1) (list 'p '$sp1 1))
        (list 'Sbj (list 'n '$sn1) (list 'p '$sp1)) (list 'VPred (list 'n '$sn1) (list 'p '$sp1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1 3))
        (list 'DET (list 'n '$sn1)) (list 'N (list 'n '$sn1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1) (list 'c '$sc1))
        (list 'PRON (list 'n '$sn1) (list 'p '$sp1) (list 'c 0)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1))
        (list 'V (list 'n '$sn1) (list 'p '$sp1)))
  (list 'Obj (list 'PRON (list 'c 1)))))
(define-function f66-teeth2 (toks)
  (let ((keep *fg-decl*))
    (set *fg-decl* *fg-decl-bad2*)
    (let ((r (fg-accept-gen toks)))
      (set *fg-decl* keep)
      r)))
(define-function f66-tcnt2 (ss ok) (if (not (pair? ss)) ok (f66-tcnt2 (cdr ss) (+ ok (if (f66-teeth2 (car ss)) 1 0)))))
(print "TEETH2 conflict-default-accepted=" (f66-tcnt2 *SAMPLE* 0) "/" (fg-len *SAMPLE*) "\n")
(f64-gprint *SAMPLE* 0)