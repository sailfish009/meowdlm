;;; compare57.l — 학습 후(어휘 가지치기 + 채택 규칙 3) 현재 버전 측정 (0.0058)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(load "data/surface_frames.l")
(load "data/surface_slots.l")
(load "data/surface_cats.l")
(define-function c-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (c-take (cdr xs) (- n 1))) ())))
(define-function c-rv (xs acc) (if (pair? xs) (c-rv (cdr xs) (cons (car xs) acc)) acc))
(define-function c-sents (toks cur acc)
  (if (not (pair? toks)) (c-rv (if (pair? cur) (cons (c-rv cur ()) acc) acc) ())
    (if (equal (car toks) ".") (c-sents (cdr toks) () (if (pair? cur) (cons (c-rv cur ()) acc) acc))
      (c-sents (cdr toks) (cons (car toks) cur) acc))))
(define-function c-any (ss rules lex) (if (not (pair? ss)) false (if (syn-accepts (car ss) rules lex) true (c-any (cdr ss) rules lex))))
(define-function c-surf (cats rules lex acc)
  (if (not (pair? cats)) acc (let* ((s (s-realize (car cats) "probe" 2621440 *frames* *slots* 8)) (ss (c-sents (s-tokens s) () ())))
    (c-surf (cdr cats) rules lex (+ acc (if (c-any ss rules lex) 1 0))))))
(define *V2* (cons (list "S" (list "INTJ" "CL")) (cons (list "NG" (list "N" "CL")) (cons (list "VL" (list "AUX" "AUX" "V")) *rules*))))
(define *TR200* (c-take *corpus* 200))
(define *LEXL* (lx-prune *lexicon* *rules* *TR200* 3 1))
(define *AL0* (lx-total *lexicon* 0))
(define *AL1* (lx-total *LEXL* 0))
(print "LEX amb " *AL0* " -> " *AL1* " | rules " (syn-len *rules*) " -> " (syn-len *V2*) "\n")
(print "COV base33/lex0  " (syn-count-accepts *corpus* *rules* *lexicon*) "/1000\n")
(print "COV v2/lex0      " (syn-count-accepts *corpus* *V2* *lexicon*) "/1000\n")
(print "COV v2/lexlearned " (syn-count-accepts *corpus* *V2* *LEXL*) "/1000\n")
(print "SURF base33/lex0      " (c-surf *cats* *rules* *lexicon* 0) "/15\n")
(print "SURF v2/lexlearned    " (c-surf *cats* *V2* *LEXL* 0) "/15\n")
