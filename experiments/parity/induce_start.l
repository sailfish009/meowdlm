;;; induce_start.l — 최소 시드에서 구 구조 규칙 발명 (0.0045)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
;; 최소 시드 14규칙 (고정 33공리에서 유도 가능한 최소 골격)
(define *seed*
  (list (list "S" (list "CL")) (list "CL" (list "NP" "VP")) (list "CL" (list "VP")) (list "CL" (list "NP"))
        (list "NP" (list "DET" "NG")) (list "NP" (list "NG")) (list "NP" (list "PRON"))
        (list "NG" (list "N")) (list "NG" (list "A" "NG")) (list "NG" (list "N" "PP"))
        (list "VP" (list "V")) (list "VP" (list "V" "NP")) (list "VP" (list "V" "PP"))
        (list "PP" (list "PREP" "NP"))))
(define-function g-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (g-take (cdr xs) (- n 1))) ())))
(define *S200* (g-take *corpus* 100))
(print "SEED rules=" (g-len *seed*) " | FULL rules=" (g-len *rules*) "\n")
(print "A seed  cov=" (g-cover *S200* *seed* *lexicon* 0) "/100 rev=" (g-revcover *S200* *seed* *lexicon* 0) "\n")
(print "F full33 cov=" (g-cover *S200* *rules* *lexicon* 0) "/100 rev=" (g-revcover *S200* *rules* *lexicon* 0) "\n")
(define *R* (g-loop *seed* *S200* *lexicon* 0 16 ()))
(define *IND* (car *R*))
(print "IND rules=" (g-len *IND*) " merges=" (car (cdr *R*)) "\n")
(print "B induced cov=" (g-cover *S200* *IND* *lexicon* 0) "/100 rev=" (g-revcover *S200* *IND* *lexicon* 0) "\n")
(define-function show-rules (rs i) (if (pair? rs) (begin (print "R" i " " (g-lhs (car rs)) " -> " (g-cat (car (g-rhs (car rs))) (if (pair? (cdr (g-rhs (car rs)))) (g-cat " " (car (cdr (g-rhs (car rs))))) "")) "\n") (show-rules (cdr rs) (+ i 1))) ()))
(print "MERGES " (car (cdr *R*)) "\n")
(show-rules *IND* 0)
