;;; span_start.l — 병합 폭 L 실험 (0.0046)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/syntax_grammar.l")
(define *seed* (list (list "S" (list "CL")) (list "CL" (list "NP" "VP")) (list "CL" (list "VP")) (list "CL" (list "NP")) (list "NP" (list "DET" "NG")) (list "NP" (list "NG")) (list "NP" (list "PRON")) (list "NG" (list "N")) (list "NG" (list "A" "NG")) (list "NG" (list "N" "PP")) (list "VP" (list "V")) (list "VP" (list "V" "NP")) (list "VP" (list "V" "PP")) (list "PP" (list "PREP" "NP"))))
(define *S100* (g-take *corpus* 100))
(print "BASE seed cov=" (g-cover *S100* *seed* *lexicon* 0) " rev=" (g-revcover *S100* *seed* *lexicon* 0) " full=" (g-cover *S100* *rules* *lexicon* 0) "\n")
(define-function arm (L) (let* ((r (g-loopL *seed* *S100* *lexicon* 0 16 L ())) (ind (car r)) (k (car (cdr r)))) (print "L" (g-int->str L) " rules=" (g-len ind) " merges=" k " cov=" (g-cover *S100* ind *lexicon* 0) " rev=" (g-revcover *S100* ind *lexicon* 0) "\n")))
(arm 2)
(arm 3)
