;;; absorb_start.l — OOV 매핑 + 단서 재추출 (0.0043)
(load "data/ev.l")
(load "data/idf.l")
(load "data/vocab.l")
(load "data/probe.l")
(load "data/oov_vocab.l")
(define *t1* 6554)
(define *t2* 13107)
(define *t3* 19661)
(define-function t-assoc (k xs) (if (pair? xs) (if (equal k (o-nth (car xs) 0)) (car xs) (t-assoc k (cdr xs))) ()))
(define-function tmap-one (w tau acc) (if (e-known? w *vocab-buckets*) acc (let ((m (o-nth (o-map w *oov-vocab* tau) 0))) (if (equal m w) acc (if (pair? (t-assoc w acc)) acc (cons (list w m) acc))))))
(define-function tmap-toks (ts tau acc) (if (pair? ts) (tmap-toks (cdr ts) tau (tmap-one (car ts) tau acc)) acc))
(define-function tmap-text (text tau acc) (tmap-toks (i-tokens text) tau acc))
(define-function tmap (ps tau acc) (if (pair? ps) (tmap (cdr ps) tau (tmap-text (car ps) tau acc)) (o-rev acc)))
(define-function t-sub (ts tbl acc) (if (pair? ts) (let ((h (t-assoc (car ts) tbl))) (t-sub (cdr ts) tbl (cons (if (pair? h) (o-nth h 1) (car ts)) acc))) (o-rev acc)))
(define-function cues-of (text tbl) (let* ((ws (i-content (t-sub (i-tokens text) tbl ()) ()))) (i-merge (i-merge ws (i-ngrams ws 2)) (i-ngrams ws 3))))
(define-function run1 (text tbl i tag) (let ((r (e-decide (cues-of text tbl) () *ev-buckets* *idf-buckets* *vocab-buckets*))) (print tag i "|" (e-nth r 0) "|" (e-nth r 1) "\n")))
(define-function run (ps tbl i tag) (if (pair? ps) (begin (run1 (car ps) tbl i tag) (run (cdr ps) tbl (+ i 1) tag)) ()))
(define *T1* (tmap *probes* *t1* ()))
(define *T2* (tmap *probes* *t2* ()))
(define *T3* (tmap *probes* *t3* ()))
(print "ABSORB probes=" (i-len *probes*) " map55=" (i-len *T1*) " map70=" (i-len *T2*) " map85=" (i-len *T3*) "\n")
(run *probes* *T1* 0 "M55")
(run *probes* *T2* 0 "M70")
(run *probes* *T3* 0 "M85")
