;;; certify_start.l — 생성 → 선형화 → 검사 + 변조 거부 (0.0050)
(load "data/syntax_grammar.l")
(load "data/syntax_lexicon.l")
(define-function c-chs (s i n) (if (< i n) (cons (string-at s i) (c-chs s (+ i 1) n)) ()))
(define-function c-merge (as bs) (if (pair? as) (cons (car as) (c-merge (cdr as) bs)) bs))
(define-function c-cat2 (a b) (list->string (c-merge (c-chs a 0 (string-length a)) (c-chs b 0 (string-length b)))))
(define-function c-join-acc (xs s) (if (pair? xs) (c-join-acc (cdr xs) (if (= 0 (string-length s)) (car xs) (c-cat2 s (c-cat2 " " (car xs))))) s))
(define-function c-join (xs) (c-join-acc xs (list->string ())))
(define-function emit1 (tr i) (let ((r (c-check tr *lex*))) (print "T" i "|" (if (car r) "1" "0") "|" (c-join (c-lin tr)) "|" (if (car r) "-" (c-join (c-nth r 1))) "\n")))
(define-function emit-t (ts i) (if (pair? ts) (begin (emit1 (car ts) i) (emit-t (cdr ts) (+ i 1))) ()))
(define-function c-mk-s2 (subj vp) (list "S" (c-num subj) -1 (list (c-mut-leafnum subj) vp)))
(define-function mut1 (tr i) (let* ((r (c-check (c-mut-num tr) *lex*)) (tr2 (c-mk-s2 (c-nth (c-kids tr) 0) (c-nth (c-kids tr) 1))) (r2 (c-check tr2 *lex*))) (print "M" i "|" (if (car r) "1" "0") "|" (if (car r2) "1" "0") "|" (c-join (c-nth r 1)) "|" (c-join (c-nth r2 1)) "\n")))
(define-function mutate-all (ts i) (if (pair? ts) (begin (mut1 (car ts) i) (mutate-all (cdr ts) (+ i 1))) ()))
(define-function cfg-all (ts i) (if (pair? ts) (begin (print "C" i "|" (if (syn-accepts (c-lin (car ts)) *rules* *lexicon*) "1" "0") "\n") (cfg-all (cdr ts) (+ i 1))) ()))
(define *trees* (c-gen-trees (c-gen-nps (list "cat" "dog" "fish") ())))
(print "GEN trees=" (c-len *trees*) "\n")
(emit-t *trees* 0)
(mutate-all *trees* 0)
(cfg-all *trees* 0)
