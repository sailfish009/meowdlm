;;; state_start.l — 저장/로드/결정성/철회 재생/손상 거부 (0.0051)
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(define-function st-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (st-take (cdr xs) (- n 1))) ())))
(define *rules-out* (list (list "S" (list "CL")) (list "CL" (list "NP" "VP")) (list "CL" (list "VP")) (list "NP" (list "DET" "NG")) (list "NP" (list "NG")) (list "NG" (list "N")) (list "VP" (list "V")) (list "VP" (list "V" "NP")) (list "PP" (list "PREP" "NP"))))
(define *journal* (list (list 1 "adopt" "X0") (list 2 "adopt" "X1") (list 3 "retract" "NP")))
(define *h1* (st-save 1 *rules-out* *journal*))
(print "SAVE gh=" (car *h1*) " jh=" (car (cdr *h1*)) "\n")
(define *h2* (st-save 1 *rules-out* *journal*))
(print "DETERMINISM " (if (and (= (car *h1*) (car *h2*)) (= (car (cdr *h1*)) (car (cdr *h2*)))) "1" "0") "\n")
(print "LOAD " (st-load 1) "\n")
(print "COVER " (syn-count-accepts (st-take *corpus* 100) *st-rules* *lexicon*) "/100\n")
(define-function st-remove (x rules) (if (pair? rules) (if (equal (car (car rules)) x) (st-remove x (cdr rules)) (cons (car rules) (st-remove x (cdr rules)))) ()))
(define-function st-apply (rules evs) (if (pair? evs) (let ((e (car evs))) (if (equal (car (cdr e)) "retract") (st-apply (st-remove (car (cdr (cdr e))) rules) (cdr evs)) (st-apply rules (cdr evs)))) rules))
(print "REPLAY cover=" (syn-count-accepts (st-take *corpus* 100) (st-apply *st-rules* *st-journal*) *lexicon*) "/100\n")
(define-function st-corrupt (path)
  (let* ((tmp (concat-string path ".bad")) (f (file-open tmp "w")) (s (file-stream f)))
    (print-all s "(define *st-rules* '((\"S\" (\"CL\"))))\n")
    (file-close f)
    (file-replace tmp path)
    true))
(st-corrupt "state/gen-1/grammar.l")
(print "CORRUPT-RELOAD " (st-load 1) "\n")
