;;; fgm69.l — 의미 슬롯 + 변조 의미 거부 (0.0069) — 지역 치환표 + 특질 이름 기반 인터페이스, 유도 트리/증명서 (0.0067)
(load "data/lexfeat_data.l")
(define f69-lin ())
(define f69-linkids ())
(load "src/meow/lexfeat.l")
(load "src/meow/fgw.l")
(load "src/meow/fgrammar.l")
;; 전체 11규칙 선언 (유일한 원천)
(define-function fg-decl11 () (list
  (list 'S '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'clause 0 1)
        (list 'Sbj (list 'n '$sn1) (list 'p '$sp1)) (list 'VPred (list 'n '$sn1) (list 'p '$sp1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1 3)) (list 'sem 'np 0 1)
        (list 'DET (list 'n '$dn)) (list 'N (list 'n '$sn1) (list 'guard 'det-n '$dn '$sn1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1) (list 'c '$sc1)) (list 'sem 'np 0)
        (list 'PRON (list 'n '$sn1) (list 'p '$sp1) (list 'c 0)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0)
        (list 'V (list 'v '$v1) (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'intr '$v1 '$v1) (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0 1)
        (list 'V (list 'v '$v1) (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'tr '$v1 '$v1) (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1))
        (list 'Obj))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0 1)
        (list 'COP (list 'p '$vp1) (list 'n '$vn1) (list 'guard 'agree-cop '$vp1 '$vn1 '$sp1 '$sn1))
        (list 'Comp))
  (list 'Obj '=> (list (list 'n '$dn2)) (list 'sem 'np 0 1)
        (list 'DET (list 'n '$dn)) (list 'N (list 'n '$dn2) (list 'guard 'det-n '$dn '$dn2)))
  (list 'Obj '=> () (list 'sem 'np 0) (list 'PRON (list 'c 1)))
  (list 'Comp (list 'A)) (list 'Comp (list 'PREP)) (list 'Comp (list 'Obj))))
;; 단일 차분: S 기본값만 1인칭으로 바꾼 선언
(define-function fg-decl11-bad () (list
  (list 'S '=> (list (list 'n '$sn1) (list 'p '$sp1 1))
        (list 'Sbj (list 'n '$sn1) (list 'p '$sp1)) (list 'VPred (list 'n '$sn1) (list 'p '$sp1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1 3)) (list 'sem 'np 0 1)
        (list 'DET (list 'n '$dn)) (list 'N (list 'n '$sn1) (list 'guard 'det-n '$dn '$sn1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1) (list 'c '$sc1)) (list 'sem 'np 0)
        (list 'PRON (list 'n '$sn1) (list 'p '$sp1) (list 'c 0)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0)
        (list 'V (list 'v '$v1) (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'intr '$v1 '$v1) (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0 1)
        (list 'V (list 'v '$v1) (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'tr '$v1 '$v1) (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1))
        (list 'Obj))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0 1)
        (list 'COP (list 'p '$vp1) (list 'n '$vn1) (list 'guard 'agree-cop '$vp1 '$vn1 '$sp1 '$sn1))
        (list 'Comp))
  (list 'Obj '=> (list (list 'n '$dn2)) (list 'sem 'np 0 1)
        (list 'DET (list 'n '$dn)) (list 'N (list 'n '$dn2) (list 'guard 'det-n '$dn '$dn2)))
  (list 'Obj '=> () (list 'sem 'np 0) (list 'PRON (list 'c 1)))
  (list 'Comp (list 'A)) (list 'Comp (list 'PREP)) (list 'Comp (list 'Obj))))
;; 단일 차분 2: Sbj 기본값만 3→1 (행동에 닿는 자리)
(define-function fg-decl11-bad-sbj () (list
  (list 'S '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'clause 0 1)
        (list 'Sbj (list 'n '$sn1) (list 'p '$sp1)) (list 'VPred (list 'n '$sn1) (list 'p '$sp1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1 1))
        (list 'DET (list 'n '$dn)) (list 'N (list 'n '$sn1) (list 'guard 'det-n '$dn '$sn1)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1) (list 'c '$sc1)) (list 'sem 'np 0)
        (list 'PRON (list 'n '$sn1) (list 'p '$sp1) (list 'c 0)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0)
        (list 'V (list 'v '$v1) (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'intr '$v1 '$v1) (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0 1)
        (list 'V (list 'v '$v1) (list 'p '$vp1) (list 'n '$vn1)
              (list 'guard 'tr '$v1 '$v1) (list 'guard 'agree '$vp1 '$vn1 '$sp1 '$sn1))
        (list 'Obj))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1)) (list 'sem 'vp 0 1)
        (list 'COP (list 'p '$vp1) (list 'n '$vn1) (list 'guard 'agree-cop '$vp1 '$vn1 '$sp1 '$sn1))
        (list 'Comp))
  (list 'Obj '=> (list (list 'n '$dn2)) (list 'sem 'np 0 1)
        (list 'DET (list 'n '$dn)) (list 'N (list 'n '$dn2) (list 'guard 'det-n '$dn '$dn2)))
  (list 'Obj '=> () (list 'sem 'np 0) (list 'PRON (list 'c 1)))
  (list 'Comp (list 'A)) (list 'Comp (list 'PREP)) (list 'Comp (list 'Obj))))
;; 알파 치환 선언: 호출부는 ($x $y), 자식 내부는 다른 이름
(define-function fg-decl-alpha () (list
  (list 'S (list 'Sbj (list 'n '$x) (list 'p '$y)) (list 'VPred (list 'n '$x) (list 'p '$y)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1 3)) (list 'sem 'np 0 1)
        (list 'DET (list 'n '$dn)) (list 'N (list 'n '$sn1) (list 'guard 'det-n '$dn '$sn1)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1))
        (list 'V (list 'p '$vp) (list 'n '$vn) (list 'guard 'agree '$vp '$vn '$sp1 '$sn1)))))
;; 동일 비단말 재사용 선언
(define-function fg-decl-dup () (list
  (list 'S (list 'Obj (list 'n '$a)) (list 'CONJ) (list 'Obj (list 'n '$b)))
  (list 'Obj '=> (list (list 'n '$dn2)) (list 'DET (list 'n '$dn2)) (list 'N (list 'n '$dn2)))))
;; 문자열
(define-function f69-chs (s i n) (if (< i n) (cons (string-at s i) (f69-chs s (+ i 1) n)) ()))
(define-function f69-merge (a b) (if (pair? a) (cons (car a) (f69-merge (cdr a) b)) b))
(define-function f69-c2 (a b) (list->string (f69-merge (f69-chs a 0 (string-length a)) (f69-chs b 0 (string-length b)))))
(define-function f69-join (ws s) (if (pair? ws) (f69-join (cdr ws) (if (= 0 (string-length s)) (car ws) (f69-c2 s (f69-c2 " " (car ws))))) s))
(define-function f69-nth (xs n) (if (= n 0) (car xs) (f69-nth (cdr xs) (- n 1))))
(define-function f69-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (f69-take (cdr xs) (- n 1))) ())))
(define-function f69-mod (a b) (if (< a b) a (f69-mod (- a b) b)))
(define-function f69-stride (xs k i acc) (if (not (pair? xs)) acc (f69-stride (cdr xs) k (+ i 1) (if (= 0 (f69-mod i k)) (cons (car xs) acc) acc))))
(define-function f69-gcnt (ss ok) (if (not (pair? ss)) ok (f69-gcnt (cdr ss) (+ ok (if (car (lf-check (car ss))) 1 0)))))
(define-function f69-rt (ss ok) (if (not (pair? ss)) ok (f69-rt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11)) 1 0)))))
(define-function f69-tcnt (ts ok) (if (not (pair? ts)) ok (f69-tcnt (cdr ts) (+ ok (if (fg-chk-tree (car ts) (fg-decl11)) 1 0)))))
(define-function f69-appendl (a b) (if (pair? a) (cons (car a) (f69-appendl (cdr a) b)) b))
(define-function f69-lin (t) (if (fg-leaf? t) (list (car (cdr (cdr t)))) (f69-linkids (fg-kids-of t))))
(define-function f69-linkids (kids) (if (not (pair? kids)) () (f69-appendl (f69-lin (car kids)) (f69-linkids (cdr kids)))))
(define-function f69-lincnt (ts ok) (if (not (pair? ts)) ok (f69-lincnt (cdr ts) (+ ok (if (fg-accept-gen (f69-lin (car ts)) (fg-decl11)) 1 0)))))
(define-function f69-linshow (ts i) (if (pair? ts) (begin (print "  lin " i " " (f69-join (f69-lin (car ts)) (list->string ())) "\n") (f69-linshow (cdr ts) (+ i 1)))))
(define-function f69-tscnt (ss ok) (if (not (pair? ss)) ok (f69-tscnt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11-bad)) 1 0)))))
;; 1) 판정 대조
(define *CASES* (list (list "the" "box" "is" "mine") (list "the" "cats" "chase" "a" "dog") (list "the" "cat" "chases" "a" "dog") (list "the" "cat" "is" "mine") (list "the" "cat" "chases" "me") (list "the" "box" "are" "mine") (list "me" "sleep") (list "i" "sleep") (list "the" "cats" "chases" "a" "dog")))
(define-function f69-cnt (i ok) (if (>= i 9) ok (f69-cnt (+ i 1) (+ ok (if (equal (car (lf-check (f69-nth *CASES* i))) (fg-accept-gen (f69-nth *CASES* i) (fg-decl11))) 1 0)))))
;; 2) 생성 + 왕복 + 증명서
(define *GEN* (fg-gen-list 400 (fg-decl11)))
(define *SAMPLE* (f69-stride *GEN* 41 0 ()))
(define-function f69-copk (ws) (if (not (pair? ws)) false (if (equal (lf-cat (lf-entry (car ws))) "COP") true (f69-copk (cdr ws)))))
(define-function f69-cop? (toks) (f69-copk toks))
(define-function f69-copcnt (ss n) (if (not (pair? ss)) n (f69-copcnt (cdr ss) (if (f69-cop? (car ss)) (+ n 1) n))))
(define *TREES* (fg-tree-list 150 (fg-decl11)))
;; --- 변조·음성 증명서 (결함 3 반증)
(define-function f69-forge-tag (t) (cons 'BOGUS (cdr t)))
(define-function f69-forge-ifv (t) (if (fg-leaf? t) t (cons (car t) (cons (car (cdr t)) (cons (list (cons 'n 999) (cons 'p -42)) (fg-kids-of t))))))
(define-function f69-swap-v (t)
  (if (fg-leaf? t)
    (if (equal (fg-tree-cat t) 'V) (if (equal (fg-leaf-word t) "sleeps") (list 'leaf 'V "sleep") t) t)
    (cons (car t) (cons (car (cdr t)) (cons (car (cdr (cdr t))) (f69-swap-k (fg-kids-of t)))))))
(define-function f69-swap-k (kids) (if (not (pair? kids)) () (cons (f69-swap-v (car kids)) (f69-swap-k (cdr kids)))))
(define-function f69-negcnt (ts f ok) (if (not (pair? ts)) ok (f69-negcnt (cdr ts) f (+ ok (if (fg-chk-tree (f (car ts)) (fg-decl11)) 1 0)))))
(define-function f69-negcnt2 (ts ok) (if (not (pair? ts)) ok (f69-negcnt2 (cdr ts) (+ ok (if (fg-chk-tree (car (fg-kids-of (car ts))) (fg-decl11)) 1 0)))))

;; 3) 이빨: 전체 11규칙 단일 차분
;; 4) 결함 1 게이트
(print "ALPHA-BAD-AGR " (if (fg-accept-gen (list "the" "cats" "sleeps") (fg-decl-alpha)) "true" "false") "\n")
(print "DUP-SAME-NUM " (if (fg-accept-gen (list "the" "cat" "and" "a" "dog") (fg-decl-dup)) "true" "false") "\n")
(print "DUP-DIFF-NUM " (if (fg-accept-gen (list "the" "cat" "and" "the" "dogs") (fg-decl-dup)) "true" "false") "\n")
;; 출력
(print "PARITY " (f69-cnt 0 0) "/9\n")
(print "GEN all=" (fg-len *GEN*) " lf=" (f69-gcnt *GEN* 0) " rt=" (f69-rt *GEN* 0) "\n")
(print "CERT trees=" (fg-len *TREES*) " chk=" (f69-tcnt *TREES* 0) " lin-ok=" (f69-lincnt *TREES* 0) "\n")
(define-function f69-forge-sem (t)
  (if (fg-leaf? t) t
    (cons (car t) (cons (car (cdr t)) (cons (car (cdr (cdr t))) (cons (list 'clause 'FAKE) (fg-kids-of t)))))))
(define-function f69-negcnt3 (ts f ok) (if (not (pair? ts)) ok (f69-negcnt3 (cdr ts) f (+ ok (if (fg-chk-tree (f (car ts)) (fg-decl11)) 1 0)))))
(print "SEM-FORGED accepted=" (f69-negcnt3 *TREES* f69-forge-sem 0) "/" (fg-len *TREES*) "\n")
(define-function f69-semshow (ts i) (if (and (pair? ts) (< i 3)) (begin (print "  SEM " (f69-join (f69-lin (car ts)) (list->string ())) " => " (fg-sem-of (car ts)) "\n") (f69-semshow (cdr ts) (+ i 1)))))
(f69-semshow *TREES* 0)
(print "NEG forged-tag-accepted=" (f69-negcnt *TREES* f69-forge-tag 0) " forged-ifv-accepted=" (f69-negcnt *TREES* f69-forge-ifv 0) " nonsubtree-root-accepted=" (f69-negcnt2 *TREES* 0) " agreement-swap-accepted=" (f69-negcnt *TREES* f69-swap-v 0) "\n")
(define-function f69-bscnt (ss ok) (if (not (pair? ss)) ok (f69-bscnt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11-bad-sbj)) 1 0)))))
(define-function f69-3rd? (toks)
  (if (equal (lf-cat (lf-entry (f69-nth toks 0))) "DET") true
    (let ((p (lf-entry (f69-nth toks 0)))) (if (pair? p) (= (lf-person p) 3) false))))
(define-function f69-sbad (ss n) (if (not (pair? ss)) n (f69-sbad (cdr ss) (if (and (f69-3rd? (car ss)) (fg-accept-gen (car ss) (fg-decl11-bad))) (+ n 1) n))))
(print "TEETH-S-DEFAULT n=" (fg-len *SAMPLE*) " accepted=" (f69-tscnt *SAMPLE* 0) " 3rd-accepted=" (f69-sbad *SAMPLE* 0) " i-sleep=" (if (fg-accept-gen (list "i" "sleep") (fg-decl11-bad)) "true" "false") "\n")
(define-function f69-3sg? (toks)
  (if (equal (lf-cat (lf-entry (f69-nth toks 0))) "DET")
    (let ((n (lf-entry (f69-nth toks 1)))) (if (pair? n) (= (lf-num n) 0) false))
    (let ((p (lf-entry (f69-nth toks 0)))) (if (pair? p) (and (= (lf-person p) 3) (= (lf-num p) 0)) false))))
(define-function f69-np3sg? (toks)
  (if (equal (lf-cat (lf-entry (f69-nth toks 0))) "DET")
    (let ((n (lf-entry (f69-nth toks 1)))) (if (pair? n) (= (lf-num n) 0) false)) false))
(define-function f69-sg-acc (ss n) (if (not (pair? ss)) n (f69-sg-acc (cdr ss) (if (f69-3sg? (car ss)) (+ n 1) n))))
(define-function f69-npacc (ss n) (if (not (pair? ss)) n (f69-npacc (cdr ss) (if (f69-np3sg? (car ss)) (+ n 1) n))))
(define-function f69-npbad (ss n) (if (not (pair? ss)) n (f69-npbad (cdr ss) (if (and (f69-np3sg? (car ss)) (fg-accept-gen (car ss) (fg-decl11-bad-sbj))) (+ n 1) n))))
(define-function f69-sg-bad (ss n) (if (not (pair? ss)) n (f69-sg-bad (cdr ss) (if (and (f69-3sg? (car ss)) (fg-accept-gen (car ss) (fg-decl11-bad-sbj))) (+ n 1) n))))
(print "TEETH-SBJ-DEFAULT n=" (fg-len *SAMPLE*) " accepted=" (f69-bscnt *SAMPLE* 0) " i-sleep=" (if (fg-accept-gen (list "i" "sleep") (fg-decl11-bad-sbj)) "true" "false") " 3sg-samples=" (f69-sg-acc *SAMPLE* 0) " 3sg-wrongly-accepted=" (f69-sg-bad *SAMPLE* 0) " np3sg-samples=" (f69-npacc *SAMPLE* 0) " np3sg-wrongly-accepted=" (f69-npbad *SAMPLE* 0) "\n")
(print "BASE-3SG-BARE " (if (fg-accept-gen (list "the" "cats" "sleeps") (fg-decl11)) "true" "false") "\n")
(define-function f69-gprint (ss i) (if (pair? ss) (begin (print "  gen " i " " (f69-join (car ss) (list->string ())) " lf=" (if (car (lf-check (car ss))) "A" "R") "\n") (f69-gprint (cdr ss) (+ i 1)))))
(define-function f69-bad (ss) (if (not (pair? ss)) () (if (car (lf-check (car ss))) (f69-bad (cdr ss)) (cons (car ss) (f69-bad (cdr ss))))))
(define-function f69-showbad (ss) (if (pair? ss) (begin (print "  BADGEN " (f69-join (car ss) (list->string ())) "\n") (f69-showbad (cdr ss)))))
(f69-showbad (f69-take (f69-bad *GEN*) 8))
;; COP 가지 표본 편향: 라운드로빈 혼합 후 전체 생성에서 COP 문장 수를 센다
(print "COP-in-full-gen " (f69-copcnt *GEN* 0) "/" (fg-len *GEN*) "\n")