;;; horn_start.l — Maru 커널 판정 출력 (질의 → 관계 → 폐쇄 판정)
(load "data/facts.l")
(load "data/queries.l")
(load "data/classes.l")
(define-function h-map-first (ps) (if (pair? ps) (cons (h-nth (car ps) 0) (h-map-first (cdr ps))) ()))
(define-function h-map-second (ps) (if (pair? ps) (cons (h-nth (car ps) 1) (h-map-second (cdr ps))) ()))
(define *closed* (h-closure *facts* 64))
(define *syms* (h-append (h-append (h-keys "isa" *facts*) (h-keys "in" *facts*)) (h-append (h-keys "sub" *facts*) (h-keys "cau" *facts*))))
(define *firsts* (h-map-first *syms*))
(define *seconds* (h-map-second *syms*))
(define-function q-sym? (x) (or (h-member? x *firsts*) (h-member? x *seconds*) (q-mem? x *classes*)))
(define-function emit1 (text i) (let ((r (q-read text))) (if (not (pair? r)) (print "Q" i "none") (let ((kind (h-nth r 0)) (a (h-nth r 1)) (b (h-nth r 2))) (if (or (not (q-sym? a)) (not (q-sym? b))) (print "Q" i "none") (print "Q" i (h-verdict kind a b *closed*)))))))
(define-function emit (qs i) (if (pair? qs) (begin (emit1 (car qs) i) (emit (cdr qs) (+ i 1))) ()))
(print "HORN facts=" (h-len *facts*) " isa=" (h-len (h-nth *closed* 0)) " in=" (h-len (h-nth *closed* 1)) " cau=" (h-len (h-nth *closed* 2)))
(emit *queries* 0)
