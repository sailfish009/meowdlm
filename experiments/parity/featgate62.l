;;; featgate62.l — 구조 도출 + 자질 결합 측정 (0.0062)
(load "data/syntax_lexicon.l")
(load "data/syntax_grammar.l")
(load "data/syntax_corpus.l")
(define-function f62-nth (xs n) (if (= n 0) (car xs) (f62-nth (cdr xs) (- n 1))))
(define-function f62-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (f62-take (cdr xs) (- n 1))) ())))
(define-function f62-chs (s i n) (if (< i n) (cons (string-at s i) (f62-chs s (+ i 1) n)) ()))
(define-function f62-mrg (a b) (if (pair? a) (cons (car a) (f62-mrg (cdr a) b)) b))
(define-function f62-c2 (a b) (list->string (f62-mrg (f62-chs a 0 (string-length a)) (f62-chs b 0 (string-length b)))))
(define-function f62-join (ws s) (if (pair? ws) (f62-join (cdr ws) (if (= 0 (string-length s)) (car ws) (f62-c2 s (f62-c2 " " (car ws))))) s))
(define *CASES* (list (list "the" "box" "is" "mine") (list "the" "cats" "chase" "a" "dog") (list "the" "cat" "chases" "a" "dog") (list "the" "cat" "is" "mine") (list "the" "cat" "chases" "me") (list "the" "box" "are" "mine") (list "me" "sleep") (list "i" "sleep") (list "the" "cats" "chases" "a" "dog")))
(define *S60* (f62-take *corpus* 60))
(define-function f62-set (lex w cats) (if (not (pair? lex)) lex (if (equal w (car (car lex))) (cons (list w cats) (cdr lex)) (cons (car lex) (f62-set (cdr lex) w cats)))))
(define-function f62-add (lex w cats) (cons (list w cats) lex))
(define *LEXF* (f62-add (f62-add (f62-set (f62-set *lexicon* "cat" (list "N")) "cats" (list "N")) "chases" (list "V")) "chase" (list "V")))
(define-function f62-target (t) (if (car (lf-check t)) true false))
(define-function f62-one (mode i)
  (if (>= i (f62-nth (list 9) 0)) true
    (let* ((t (f62-nth *CASES* i)) (want (f62-target t)) (got (fg-accept t *lexicon* *rules* mode)))
      (if (equal want got) (f62-one mode (+ i 1))
        (begin (print "  miss[" mode "] " (f62-join t (list->string ())) " want=" (if want "accept" "reject") " got=" (if got "accept" "reject") "\n") (f62-one mode (+ i 1)))))))
(define-function f62-cnt (mode i ok lex) (if (>= i 9) ok (let* ((t (f62-nth *CASES* i)) (want (f62-target t)) (got (fg-accept t lex *rules* mode))) (f62-cnt mode (+ i 1) (+ ok (if (equal want got) 1 0)) lex))))
(define-function f62-cov (mode ss ok lex) (if (not (pair? ss)) ok (f62-cov mode (cdr ss) (+ ok (if (fg-accept (car ss) lex *rules* mode) 1 0)) lex)))
(ex-add "L" "cat" "added" (list "N") (list 0 0))
(ex-add "L" "cats" "added" (list "N") (list 0 0))
(ex-add "L" "chases" "added" (list "V") (list 0 0))
(ex-add "L" "chase" "added" (list "V") (list 0 0))
(print "RECORDED L=" (ex-kinds "L" 0) "\n")
(print "SAVE " (ex-save 4) "\n")
(ex-clear)
(print "RELOAD " (ex-load 4) "\n")
(define *AP* (ap-build *exp* *rules* *lexicon*))
(define *LEXA* (ap-nth *AP* 1))
(print "AGREE struct=" (f62-cnt "struct" 0 0 *lexicon*) "/9 gate=" (f62-cnt "gate" 0 0 *lexicon*) "/9 gate+fix=" (f62-cnt "gate" 0 0 *LEXF*) "/9 applied=" (f62-cnt "gate" 0 0 *LEXA*) "/9\n")
(print "COV struct=" (f62-cov "struct" *S60* 0 *lexicon*) "/60 gate=" (f62-cov "gate" *S60* 0 *lexicon*) "/60 gate+fix=" (f62-cov "gate" *S60* 0 *LEXF*) "/60\n")
(f62-one "struct" 0)
(f62-one "gate" 0)
