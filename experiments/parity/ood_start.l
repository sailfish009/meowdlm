;;; ood_start.l — 단서 적중률 게이트 (0.0053): 영역 내 손실 vs OOD 기권
(load "data/ev.l")
(load "data/idf.l")
(load "data/probe_cues.l")
(load "data/ood_new.l")
(define-function emit1 (cues i cut tag)
  (let ((r (e-decide-cue cues *ev-buckets* *idf-buckets* cut)))
    (print tag i "|" (e-nth r 0) "|" (e-nth r 1) "\n")))
(define-function emit (cs i cut tag)
  (if (pair? cs) (begin (emit1 (car cs) i cut tag) (emit (cdr cs) (+ i 1) cut tag)) ()))
(print "OOD new=" (e-len *ood-cues*) "\n")
(emit *cue-lists* 0 0 "P0")
(emit *cue-lists* 0 16384 "P25")
(emit *ood-cues* 0 0 "N0")
(emit *ood-cues* 0 16384 "N25")
