;; 알파 치환 선언: 호출부는 ($x $y), 자식 내부는 다른 이름
(define-function fg-decl-alpha () (list
  (list 'S (list 'Sbj (list 'n '$x) (list 'p '$y)) (list 'VPred (list 'n '$x) (list 'p '$y)))
  (list 'Sbj '=> (list (list 'n '$sn1) (list 'p '$sp1 3))
        (list 'DET (list 'n '$sn1)) (list 'N (list 'n '$sn1)))
  (list 'VPred '=> (list (list 'n '$sn1) (list 'p '$sp1))
        (list 'V (list 'p '$vp) (list 'n '$vn) (list 'guard 'agree '$vp '$vn '$sp1 '$sn1)))))
;; 동일 비단말 재사용 선언
(define-function fg-decl-dup () (list
  (list 'S (list 'Obj (list 'n '$a)) (list 'CONJ) (list 'Obj (list 'n '$b)))
  (list 'Obj '=> (list (list 'n '$dn2)) (list 'DET (list 'n '$dn2)) (list 'N (list 'n '$dn2)))))
;; 문자열
(define-function f67-chs (s i n) (if (< i n) (cons (string-at s i) (f67-chs s (+ i 1) n)) ()))
(define-function f67-merge (a b) (if (pair? a) (cons (car a) (f67-merge (cdr a) b)) b))
(define-function f67-c2 (a b) (list->string (f67-merge (f67-chs a 0 (string-length a)) (f67-chs b 0 (string-length b)))))
(define-function f67-join (ws s) (if (pair? ws) (f67-join (cdr ws) (if (= 0 (string-length s)) (car ws) (f67-c2 s (f67-c2 " " (car ws))))) s))
(define-function f67-nth (xs n) (if (= n 0) (car xs) (f67-nth (cdr xs) (- n 1))))
(define-function f67-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (f67-take (cdr xs) (- n 1))) ())))
(define-function f67-mod (a b) (if (< a b) a (f67-mod (- a b) b)))
(define-function f67-stride (xs k i acc) (if (not (pair? xs)) acc (f67-stride (cdr xs) k (+ i 1) (if (= 0 (f67-mod i k)) (cons (car xs) acc) acc))))
(define-function f67-gcnt (ss ok) (if (not (pair? ss)) ok (f67-gcnt (cdr ss) (+ ok (if (car (lf-check (car ss))) 1 0)))))
(define-function f67-rt (ss ok) (if (not (pair? ss)) ok (f67-rt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11)) 1 0)))))
(define-function f67-tcnt (ts ok) (if (not (pair? ts)) ok (f67-tcnt (cdr ts) (+ ok (if (fg-chk (car ts) (fg-decl11)) 1 0)))))
(define-function f67-appendl (a b) (if (pair? a) (cons (car a) (f67-appendl (cdr a) b)) b))
(define-function f67-lin (t) (if (fg-leaf? t) (list (car (cdr (cdr t)))) (f67-linkids (fg-kids-of t))))
(define-function f67-linkids (kids) (if (not (pair? kids)) () (f67-appendl (f67-lin (car kids)) (f67-linkids (cdr kids)))))
(define-function f67-lincnt (ts ok) (if (not (pair? ts)) ok (f67-lincnt (cdr ts) (+ ok (if (fg-accept-gen (f67-lin (car ts)) (fg-decl11)) 1 0)))))
(define-function f67-linshow (ts i) (if (pair? ts) (begin (print "  lin " i " " (f67-join (f67-lin (car ts)) (list->string ())) "\n") (f67-linshow (cdr ts) (+ i 1)))))
(define-function f67-tscnt (ss ok) (if (not (pair? ss)) ok (f67-tscnt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11-bad)) 1 0)))))
;; 1) 판정 대조
(define *CASES* (list (list "the" "box" "is" "mine") (list "the" "cats" "chase" "a" "dog") (list "the" "cat" "chases" "a" "dog") (list "the" "cat" "is" "mine") (list "the" "cat" "chases" "me") (list "the" "box" "are" "mine") (list "me" "sleep") (list "i" "sleep") (list "the" "cats" "chases" "a" "dog")))
(define-function f67-cnt (i ok) (if (>= i 9) ok (f67-cnt (+ i 1) (+ ok (if (equal (car (lf-check (f67-nth *CASES* i))) (fg-accept-gen (f67-nth *CASES* i) (fg-decl11))) 1 0)))))
;; 2) 생성 + 왕복 + 증명서
(define *GEN* (fg-gen-list 400 (fg-decl11)))
(define *SAMPLE* (f67-stride *GEN* 17 0 ()))
(define *TREES* (fg-tree-list 150 (fg-decl11)))
;; 3) 이빨: 전체 11규칙 단일 차분
;; 4) 결함 1 게이트
(print "ALPHA-BAD-AGR " (if (fg-accept-gen (list "the" "cats" "sleeps") (fg-decl-alpha)) "true" "false") "\n")
(print "DUP-SAME-NUM " (if (fg-accept-gen (list "the" "cat" "and" "a" "dog") (fg-decl-dup)) "true" "false") "\n")
(print "DUP-DIFF-NUM " (if (fg-accept-gen (list "the" "cat" "and" "the" "dogs") (fg-decl-dup)) "true" "false") "\n")
;; 출력
(print "PARITY " (f67-cnt 0 0) "/9\n")
(print "GEN all=" (fg-len *GEN*) " lf=" (f67-gcnt *GEN* 0) " rt=" (f67-rt *GEN* 0) "\n")
(print "CERT trees=" (fg-len *TREES*) " chk=" (f67-tcnt *TREES* 0) " lin-ok=" (f67-lincnt *TREES* 0) "\n")
(define-function f67-bscnt (ss ok) (if (not (pair? ss)) ok (f67-bscnt (cdr ss) (+ ok (if (fg-accept-gen (car ss) (fg-decl11-bad-sbj)) 1 0)))))
(print "TEETH-S-DEFAULT n=" (fg-len *SAMPLE*) " accepted=" (f67-tscnt *SAMPLE* 0) " i-sleep=" (if (fg-accept-gen (list "i" "sleep") (fg-decl11-bad)) "true" "false") "\n")
(define-function f67-3sg? (toks)
  (if (equal (lf-cat (lf-entry (f67-nth toks 0))) "DET")
    (let ((n (lf-entry (f67-nth toks 1)))) (if (pair? n) (= (lf-num n) 0) false))
    (let ((p (lf-entry (f67-nth toks 0)))) (if (pair? p) (and (= (lf-person p) 3) (= (lf-num p) 0)) false))))
(define-function f67-np3sg? (toks)
  (if (equal (lf-cat (lf-entry (f67-nth toks 0))) "DET")
    (let ((n (lf-entry (f67-nth toks 1)))) (if (pair? n) (= (lf-num n) 0) false)) false))
(define-function f67-sg-acc (ss n) (if (not (pair? ss)) n (f67-sg-acc (cdr ss) (if (f67-3sg? (car ss)) (+ n 1) n))))
(define-function f67-npacc (ss n) (if (not (pair? ss)) n (f67-npacc (cdr ss) (if (f67-np3sg? (car ss)) (+ n 1) n))))
(define-function f67-npbad (ss n) (if (not (pair? ss)) n (f67-npbad (cdr ss) (if (and (f67-np3sg? (car ss)) (fg-accept-gen (car ss) (fg-decl11-bad-sbj))) (+ n 1) n))))
(define-function f67-sg-bad (ss n) (if (not (pair? ss)) n (f67-sg-bad (cdr ss) (if (and (f67-3sg? (car ss)) (fg-accept-gen (car ss) (fg-decl11-bad-sbj))) (+ n 1) n))))
(print "TEETH-SBJ-DEFAULT n=" (fg-len *SAMPLE*) " accepted=" (f67-bscnt *SAMPLE* 0) " i-sleep=" (if (fg-accept-gen (list "i" "sleep") (fg-decl11-bad-sbj)) "true" "false") " 3sg-samples=" (f67-sg-acc *SAMPLE* 0) " 3sg-wrongly-accepted=" (f67-sg-bad *SAMPLE* 0) " np3sg-samples=" (f67-npacc *SAMPLE* 0) " np3sg-wrongly-accepted=" (f67-npbad *SAMPLE* 0) "\n")
(print "BASE-3SG-BARE " (if (fg-accept-gen (list "the" "cats" "sleeps") (fg-decl11)) "true" "false") "\n")
(define-function f67-gprint (ss i) (if (pair? ss) (begin (print "  gen " i " " (f67-join (car ss) (list->string ())) " lf=" (if (car (lf-check (car ss))) "A" "R") "\n") (f67-gprint (cdr ss) (+ i 1)))))
(f67-gprint (f67-take *SAMPLE* 9) 0)
