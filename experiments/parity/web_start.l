;;; web_start.l — 웹 자료(품사·구문 규칙) 채택 실험 (0.0044)
(load "data/syntax_grammar.l")
(load "data/syntax_lexicon.l")
(load "data/syntax_corpus.l")
(load "data/web_pos.l")
(load "data/web_rules.l")

(define-function w-rev (xs acc) (if (pair? xs) (w-rev (cdr xs) (cons (car xs) acc)) acc))
(define-function w-take (xs n) (if (= n 0) () (if (pair? xs) (cons (car xs) (w-take (cdr xs) (- n 1))) ())))
(define-function w-len-acc (xs a) (if (pair? xs) (w-len-acc (cdr xs) (+ a 1)) a))
(define-function w-assoc (k xs) (if (pair? xs) (if (equal k (car (car xs))) (car xs) (w-assoc k (cdr xs))) ()))
(define-function w-replace (xs k v) (if (pair? xs) (if (equal k (car (car xs))) (cons (list k v) (cdr xs)) (cons (car xs) (w-replace (cdr xs) k v))) ()))
(define-function w-mem (x xs) (if (pair? xs) (if (equal x (car xs)) true (w-mem x (cdr xs))) false))
(define-function w-app (a b) (if (pair? a) (cons (car a) (w-app (cdr a) b)) b))
(define-function w-cover (ss rules lex n) (if (pair? ss) (+ (if (syn-accepts (car ss) rules lex) 1 0) (w-cover (cdr ss) rules lex n)) 0))
(define-function w-revcover (ss rules lex) (if (pair? ss) (+ (if (syn-accepts (w-rev (car ss) ()) rules lex) 1 0) (w-revcover (cdr ss) rules lex)) 0))
(define-function w-len (xs) (w-len-acc xs 0))
(define-function w-union (a b) (if (pair? a) (w-union (cdr a) (if (w-mem (car a) b) b (cons (car a) b))) b))
(define-function w-amb (lex acc) (if (pair? lex) (w-amb (cdr lex) (+ acc (w-len (car (cdr (car lex)))))) acc))
(define-function run (label rules lex ss) (print label " cov=" (w-cover ss rules lex 0) "/" (w-len ss) " rev=" (w-revcover ss rules lex) " amb=" (w-amb lex 0) "\n"))
(define-function w-add (base e) (let ((hit (w-assoc (car e) base))) (if (pair? hit) (w-replace base (car e) (w-union (car (cdr hit)) (car (cdr e)))) (cons e base))))
(define-function w-merge (base extra) (if (pair? extra) (w-merge (w-add base (car extra)) (cdr extra)) base))
(define-function w-uniq-lex (base extra) (w-merge base extra))
(define *LEXC* (w-uniq-lex *lexicon* *web-pos*))
(define *RULESB* (w-app *rules* *web-rules*))
(define *SUB* (w-take *corpus* 200))
(print "WEB corpus=" (w-len *SUB*) " rules=" (w-len *rules*) "+" (w-len *web-rules*) " lex=" (w-len *lexicon*) "+" (w-len *web-pos*) "\n")
(run "A base            " *rules* *lexicon* *SUB*)
(run "B +web-rules      " *RULESB* *lexicon* *SUB*)
(run "C +web-pos        " *rules* *LEXC* *SUB*)
(run "BC +both          " *RULESB* *LEXC* *SUB*)