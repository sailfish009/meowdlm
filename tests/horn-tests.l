;;; horn-tests.l — 커널 포트 검사 (Maru)
(load "data/facts.l")
(define *c* (h-closure *facts* 64))
(define *failures* 0)
(define-function check (name ok) (if ok (print "ok " name "\n") (begin (set *failures* (+ *failures* 1)) (print "FAIL " name "\n"))))
(check "isa 폐쇄 21" (= 21 (h-len (h-nth *c* 0))))
(check "in 폐쇄 27" (= 27 (h-len (h-nth *c* 1))))
(check "2-hop 도출" (h-holds? "in" "z1" "z4" *c*))
(check "6-hop 도출" (h-holds? "in" "z1" "z7" *c*))
(check "역방향 거부" (not (h-holds? "in" "z4" "z1" *c*)))
(check "subclass 상속" (h-holds? "isa" "miso" "mammal" *c*))
(check "닫힌세계 no" (equal "no" (h-verdict "isa" "miso" "plant" *c*)))
(print "HORN-TESTS failures=" *failures* "\n")
