;;; evidence-tests.l — 증거 질량 판정 포트 검사 (Maru, 0.0041 버킷 API)
(load "data/ev.l")
(load "data/idf.l")
(load "data/vocab.l")
(define *failures* 0)
(define-function check (name ok) (if ok (print "ok " name "\n") (begin (set *failures* (+ *failures* 1)) (print "FAIL " name "\n"))))
(check "단서 중복 제거" (= 3 (e-len (e-dedupe (list "a" "b" "a" "c" "b")))))
(check "증거 없음" (equal "no_evidence" (e-nth (e-decide () () *ev-buckets* *idf-buckets* *vocab-buckets*) 1)))
(define strong (list "bowl" "empty" "bowl empty"))
(check "강한 단서 판정" (equal "derived" (e-nth (e-decide strong () *ev-buckets* *idf-buckets* *vocab-buckets*) 1)))
(check "IDF 조회" (pair? (e-idf-of "bowl" *idf-buckets*)))
;; 결함 ⑤: 접두사 사전순
(check "접두사 순서 cat<cats" (equal true (e-name< "cat" "cats")))
(check "접두사 순서 cats>cat" (equal false (e-name< "cats" "cat")))
(check "동일 이름" (equal false (e-name< "cat" "cat")))
(print "EVIDENCE-TESTS failures=" *failures* "\n")
