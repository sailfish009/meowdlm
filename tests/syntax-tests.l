;;; syntax-tests.l — 문장 도출 포트 검사 (Maru)
(load "data/syntax_grammar.l")
(load "data/syntax_lexicon.l")
(define *failures* 0)
(define-function check (name ok) (if ok (print "ok " name "\n") (begin (set *failures* (+ *failures* 1)) (print "FAIL " name "\n"))))
(check "INTJ 단문" (syn-accepts (list "hello") *rules* *lexicon*))
(check "미지어 침묵" (not (syn-accepts (list "feed" "me") *rules* *lexicon*)))
(check "명령문 유지" (syn-accepts (list "pet" "me") *rules* *lexicon*))
(check "어휘 폐쇄" (syn-accepts (list "the" "box" "is" "mine") *rules* *lexicon*))
(check "빈 입력 거부" (not (syn-accepts (list) *rules* *lexicon*)))
(print "SYNTAX-TESTS failures=" *failures* "\n")
