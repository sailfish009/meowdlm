;;; ana_fixture.l — S2 수동 감사용 20케이스(라벨 손작성). 마지막 절의 주어가 대명사다.
(define-function A-np1 (w) (list 'np w))
(define-function A-np2 (d n) (list 'np d n))
(define-function A-tr (v s o) (list 'clause s (list 'vp v o)))
(define-function A-intr (v s) (list 'clause s (list 'vp v 'none)))

(define *an-cases* (list
  (list "c01" (list (A-tr "chases" (A-np2 "a" "dog") (A-np2 "a" "cat"))) "it" "ok:cat")
